#!/bin/sh
# Repository commit-msg of loken: the conventions commit-msg, then the hetero route check of the
# staged diff against the subject (the scope `hetero` marks a migration step).
g=$(git config --global core.hooksPath) && g=$(eval echo "$g")
if [ -n "$g" ] && [ -x "$g/commit-msg" ]; then
  "$g/commit-msg" "$@" || exit 1
fi
exec python3 "$(git rev-parse --show-toplevel)/scripts/check_hetero.py" --message "$1"
