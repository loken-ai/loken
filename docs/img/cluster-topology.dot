// Rendered by scripts/figures.py. Colours are mid-tones chosen to read on a white page and on
// a dark one, since a figure inherits whatever background the reader brought.
digraph cluster {
  rankdir=TB;
  bgcolor="transparent";
  node [fontname="ui-sans-serif,system-ui,sans-serif", fontsize=11, shape=box, style=rounded,
        color="#8c959f", fontcolor="#57606a", penwidth=1.2, height=.42];
  edge [color="#8c959f", fontname="ui-sans-serif,system-ui,sans-serif", fontsize=9,
        fontcolor="#57606a", arrowsize=.7];

  client [label="client", shape=plaintext, fontcolor="#57606a"];
  router [label="router\lSWIM gossip, phi-accrual detector,\land an eventually-consistent table\l",
          color="#2da44e", fontcolor="#2da44e"];

  a [label="node A\nTP=2"];
  b [label="node B\nTP=2"];
  c [label="node C\nCPU, full replica"];

  client -> router [label=" any node is an entry point "];
  router -> a;
  router -> b;
  router -> c;

  note [shape=plaintext, fontsize=9, fontcolor="#57606a",
        label="A model is sharded across nodes only when no single node holds it,\land only where the measured link cost says it pays.\l"];
  c -> note [style=invis];
}
