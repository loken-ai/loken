// Rendered by scripts/figures.py. Colours are mid-tones chosen to read on a white page and on
// a dark one, since a figure inherits whatever background the reader brought.
digraph cluster {
  rankdir=TB;
  bgcolor="transparent";
  node [fontname="DejaVu Sans, Liberation Sans, Helvetica, Arial, sans-serif", fontsize=11, shape=box, style=rounded,
        color="#8c959f", fontcolor="#57606a", penwidth=1.2, height=.42];
  edge [color="#8c959f", fontname="DejaVu Sans, Liberation Sans, Helvetica, Arial, sans-serif", fontsize=9,
        fontcolor="#57606a", arrowsize=.7];

  client [label="client", shape=plaintext, fontcolor="#57606a"];

  a [label="node A\nholds the weights", color="#2da44e", fontcolor="#2da44e"];
  b [label="node B\nno weights"];
  c [label="node C\nholds the weights"];

  client -> b [label=" any node accepts the request "];
  b -> a [label=" forwards the request once,\l relays the stream \l", color="#2da44e", fontcolor="#2da44e"];
  a -> c [dir=both, style=dashed, constraint=false, label=" state poll:\l its round trip prices the link \l"];
  b -> c [dir=both, style=dashed, constraint=false];

  note [shape=plaintext, fontsize=9, fontcolor="#57606a",
        label="Each node decides alone from the rates, the load and the link prices it measured.\lNodes find each other by multicast announcements and join seeds.\lA phi-accrual detector evicts a silent node.\l"];
  c -> note [style=invis];
  a -> note [style=invis];
}
