# A model larger than the RAM of the host and the VRAM of the card together.
# The disk holds the model file, mapped. The page cache of the host holds the pages of the file that were read.
# The card keeps what every token reads and some experts. Dots are bytes on the move, small dark dots are rows of activations.

# The experts that the routing prior ranks first, as row and column in the file.
let HOT = [[0, 1], [0, 4], [0, 7], [1, 0], [1, 3], [1, 6], [2, 2], [2, 5], [2, 8], [3, 1], [3, 4], [3, 7], [4, 0], [4, 3], [4, 6], [1, 8], [3, 0], [4, 8]]
# The places of the page cache that hold an expert, as an index along its rows.
let CACHED = [0, 2, 3, 5, 7, 9, 11, 14]
# The place of the copy stream, and of the first copy for a layer.
let STREAM = (792, 435)
let COPY = (886, 435)
# The ways between the 3 places.
let FAULT = (262, 296)
let CACHE_OUT = (630, 330)

# The middle of the expert at row `r` and column `c` of the file.
to dkAt(r, c)
  return (42 + c * 24, 269 + r * 24)
end

# The expert at row `r` and column `c` of the file.
to dk(r, c)
  return select("#dk-" + str(r) + "-" + str(c))
end

# The slot `i` of the card, counted along the rows.
to slot(i)
  let r = floor(i / 9)
  return select("#cd-" + str(r) + "-" + str(i - r * 9))
end

# The middle of the slot `i` of the card.
to slotAt(i)
  let r = floor(i / 9)
  return (747 + (i - r * 9) * 26, 346 + r * 26)
end

# The place `i` of the page cache, counted along the rows.
to place(i)
  let r = floor(i / 9)
  return select("#pc-" + str(r) + "-" + str(i - r * 9))
end

# The middle of the place `i` of the page cache.
to placeAt(i)
  let r = floor(i / 9)
  return (376 + (i - r * 9) * 29, 328 + r * 28)
end

# A packet of bytes at `p`.
to packet(p, look)
  return dot(p[0], p[1], 5.5, "pk " + look)
end

# A row of activations at `p`.
to rowAt(p)
  return dot(p[0], p[1], 3.6, "pkr")
end

# The card has loaded: it holds what every token reads and the experts of the prior.
to loaded()
  addClass("on", select("#cd-always"))
  for i in range(len(HOT))
    addClass("hot", dk(HOT[i][0], HOT[i][1]))
    addClass("in", slot(i))
  end
end

# The page cache holds the experts that were routed last.
to cached()
  for i in CACHED
    addClass("in", place(i))
  end
end

# A row crosses from `a` to `b` and is gone.
to cross(a, b)
  let d = rowAt(a)
  move d via b speed 380
  remove d
end

# An expert of the file at `p` is read into the place `i` of the page cache.
to readInto(p, i, look)
  let d = packet(p, look)
  move d via FAULT speed 600
  move d via placeAt(i) speed 420
  addClass("in", place(i))
  remove d
end


# What the file's experts are doing over time: where each of the 45 is, how often it was routed to, and how often it was seen off the card.
# A place is 0 on the disk, 1 in the RAM, 2 on the card.
let PAY = 4
let KEEP = 8
let WHERE = [0 for i in range(45)]
let FREQ = [0 for i in range(45)]
let SEEN = [0 for i in range(45)]
let SLOTS = [-1 for i in range(18)]
let PLACE = [-1 for i in range(45)]
let PLACED = [-1 for i in range(8)]
let S = {tok: 0, head: 0, nc: 0, nr: 0, nd: 0, cur: []}

# The row and the column in the file of the expert `i`.
to rowOf(i)
  return floor(i / 9)
end

to colOf(i)
  return i - floor(i / 9) * 9
end

# The square of the expert `i` in the file.
to dkOf(i)
  return dk(rowOf(i), colOf(i))
end

# The middle of the square of the expert `i` in the file.
to dkPt(i)
  return dkAt(rowOf(i), colOf(i))
end

# The square of the expert `i` takes the colour of where it is.
to paint(i)
  let c = dkOf(i)
  dropClass("hot", c)
  dropClass("inram", c)
  if WHERE[i] == 2
    addClass("hot", c)
  elif WHERE[i] == 1
    addClass("inram", c)
  end
end

# The slot of the card that holds the expert `i`, or -1.
to slotOf(i)
  for s in range(18)
    if SLOTS[s] == i
      return s
    end
  end
  return -1
end

# Whether the token that runs routes to the expert `i`.
to routed(i)
  for k in range(len(S.cur))
    if S.cur[k] == i
      return true
    end
  end
  return false
end

# The expert `i` is read from the disk into the page cache, which gives way to the experts used last.
to ramAdd(i)
  let p = S.head % KEEP
  S.head += 1
  let old = PLACED[p]
  if old >= 0
    WHERE[old] = 0
    PLACE[old] = -1
    paint(old)
    dropClass("in", place(p))
  end
  PLACED[p] = i
  PLACE[i] = p
  WHERE[i] = 1
  readInto(dkPt(i), p, "pkc")
  paint(i)
end

# The expert `i`, seen often enough, moves from the RAM to the card, and the card trades out its coldest expert if it is full.
to upload(i)
  let s = -1
  for k in range(18)
    if SLOTS[k] == -1 and s < 0
      s = k
    end
  end
  if s < 0
    let best = 999
    for k in range(18)
      let v = SLOTS[k]
      if v >= 0 and not routed(v) and FREQ[v] < best and FREQ[v] < SEEN[i]
        best = FREQ[v]
        s = k
      end
    end
  end
  if s < 0
    return
  end
  let p = PLACE[i]
  let d = packet(placeAt(p), "pk")
  move d via CACHE_OUT speed 520
  move d via STREAM speed 520
  move d via slotAt(s) speed 520
  remove d
  let v = SLOTS[s]
  if v >= 0
    WHERE[v] = 0
    paint(v)
  end
  SLOTS[s] = i
  WHERE[i] = 2
  FREQ[i] = SEEN[i]
  PLACED[p] = -1
  PLACE[i] = -1
  dropClass("in", place(p))
  addClass("in", slot(s))
  addClass("fresh", slot(s))
  paint(i)
  wait 300
  dropClass("fresh", slot(s))
end

# A token routes to the experts `ids`: those on the card run there, the others run on the host.
to route(ids)
  S.tok += 1
  S.cur = ids
  S.nc = 0
  S.nr = 0
  S.nd = 0
  retext(named("tok-n"), "TOKEN " + str(S.tok))
  for i in ids
    addClass("want", dkOf(i))
  end
  wait 300
  for i in ids
    if WHERE[i] == 2
      S.nc += 1
      FREQ[i] += 1
      addClass("run", slot(slotOf(i)))
    elif WHERE[i] == 1
      S.nr += 1
      SEEN[i] += 1
    else
      S.nd += 1
      SEEN[i] += 1
      ramAdd(i)
    end
  end
  retext(named("tok-stat"), "VRAM " + str(S.nc) + "  RAM " + str(S.nr) + "  DISK " + str(S.nd))
  if S.nr + S.nd > 0
    addClass("run", query(".core"))
  end
  wait 700
  dropClass("run", query(".cd"))
  dropClass("run", query(".core"))
  for i in ids
    dropClass("want", dkOf(i))
  end
  for i in ids
    if WHERE[i] != 2 and SEEN[i] >= PAY
      upload(i)
    end
  end
end

# The card holds the experts of the prior at the start of a story of tokens.
to prior()
  addClass("on", select("#cd-always"))
  for k in range(len(HOT))
    let i = HOT[k][0] * 9 + HOT[k][1]
    SLOTS[k] = i
    WHERE[i] = 2
    FREQ[i] = 2
    paint(i)
    addClass("in", slot(k))
  end
end

scene load
  # Step 0: The file is larger than the RAM and the VRAM together, so it is not read whole.
  # The host maps it, and a page is read from the disk only when something touches it.
  step 0
  view (16, 104, 250, 376) over 600ms
  wait 500
  wave query(".dk") 18ms
  emit at (36, 106) "mapped, not read"
  wait 1300

  # Step 1: The weights every token reads cross to the card once and stay there.
  # They are read from the disk through the RAM, and copied into the VRAM before any routed expert.
  step 1
  view all
  for k in range(3)
    addClass("want", select("#dk-a" + str(k)))
  end
  wait 500
  together for k in range(3)
    wait k * 160
    let d = packet((66 + k * 76, 208), "pk")
    move d via FAULT speed 500
    move d via (376, 328) speed 500
    move d via CACHE_OUT speed 500
    move d via (852, 293) speed 520
    remove d
  end
  addClass("on", select("#cd-always"))
  emit at (740, 196) "copied to the VRAM, once"
  wait 1000

  # Step 2: The room left in the VRAM is cut into expert slots.
  # Before the first request, the slots are filled from the routing prior, the most used experts of every layer first.
  # Each expert is read from the disk, copied to the card, and its pages leave the RAM.
  step 2
  view all
  for g in range(3)
    together for j in range(6)
      let i = g * 6 + j
      wait j * 110
      let h = HOT[i]
      let d = packet(dkAt(h[0], h[1]), "pk")
      addClass("moved", dk(h[0], h[1]))
      move d via FAULT speed 700
      move d via (376, 328) speed 700
      move d via CACHE_OUT speed 700
      move d via slotAt(i) speed 700
      addClass("in", slot(i))
      remove d
      drop "moved" from dk(h[0], h[1])
      addClass("hot", dk(h[0], h[1]))
    end
  end
  emit at (740, 196) "most used first"
  wait 900

  # Step 3: Every other expert stays on the disk.
  # The host reads it in place when a token routes to it, and its page cache keeps the pages that were read.
  step 3
  view (16, 104, 628, 376) over 600ms
  addClass("want", dk(3, 2))
  wait 400
  readInto(dkAt(3, 2), 0, "pkc")
  drop "want" from dk(3, 2)
  emit at (270, 222) "read in place"
  wait 1200

  # Step 4: How many experts the page cache keeps for each layer moves while the server runs.
  # It grows while the host has the room and the kernel reports no more memory stalls, and it falls back when it does.
  step 4
  view (336, 224, 308, 256) over 600ms
  for i in range(len(CACHED))
    addClass("in", place(CACHED[i]))
  end
  wait 500
  addClass("in", place(1))
  addClass("in", place(4))
  emit at (352, 222) "grows while there is room"
  wait 1400
  drop "in" from place(1)
  drop "in" from place(4)
  drop "in" from place(14)
  emit at (352, 222) "falls back on stalls"
  wait 1400
end

scene time
  prior()

  # Step 0: The first tokens after the load.
  # An expert on the card runs there. The others run on the host, and each is read from the disk the first time.
  step 0
  view (16, 104, 628, 376) over 600ms
  wait 400
  route([1, 20, 21, 29])
  route([1, 9, 21, 29])
  wait 600

  # Step 1: The next tokens route to some of the same experts.
  # Those are in the RAM already, so they are not read from the disk again, and the card counts each sighting.
  step 1
  route([20, 21, 29, 41])
  wait 800

  # Step 2: An expert seen often enough repays an upload.
  # It moves from the RAM to the card, its pages leave the RAM, and the card trades out its least frequently routed expert.
  step 2
  view all
  route([1, 21, 29, 41])
  wait 800

  # Step 3: The conversation moves on to other experts.
  # They are read from the disk, and the page cache turns over: the experts used last stay and the others give way.
  step 3
  view (16, 104, 628, 376) over 600ms
  route([16, 33, 3, 10])
  route([16, 33, 3, 10])
  route([16, 33, 3, 9])
  wait 600

  # Step 4: The new experts become frequent.
  # They move to the card one by one, each trading out a colder expert, so the VRAM follows the experts the text keeps returning to.
  step 4
  view all
  route([16, 33, 3, 10])
  route([16, 33, 3, 1])
  wait 800

  # Step 5: After many tokens, most of the experts a token routes to are on the card, some are in the RAM, and the disk is read only for the rare expert.
  step 5
  view (16, 104, 628, 376) over 600ms
  route([16, 33, 3, 10])
  route([1, 16, 33, 20])
  route([16, 33, 3, 12])
  wait 1200
end

scene layer
  loaded()
  cached()

  # Step 0: A token runs the attention of a layer on the card, from the weights kept there.
  step 0
  view (716, 196, 272, 284) over 600ms
  wait 400
  addClass("run", select("#cd-always"))
  emit at (740, 196) "attention on the card"
  wait 1500
  drop "run" from select("#cd-always")

  # Step 1: A row of the stream crosses to the host, where the router names the experts.
  step 1
  view (336, 224, 380, 256) over 600ms
  cross((718, 350), (642, 350))
  addClass("want", dk(0, 1))
  addClass("want", dk(2, 2))
  addClass("want", dk(2, 3))
  addClass("want", dk(3, 2))
  emit at (352, 222) "the router names 4"
  wait 1300

  # Step 2: An expert kept in the VRAM runs on the card.
  # Its row crosses the bus, the card computes, and the product comes back.
  step 2
  view (336, 224, 652, 256) over 600ms
  together
    cross((642, 350), (718, 350))
    cross((642, 354), (718, 354))
  end
  addClass("run", slot(0))
  addClass("run", slot(6))
  wait 1100
  together
    cross((718, 372), (642, 372))
    cross((718, 376), (642, 376))
  end
  drop "run" from slot(0), slot(6)
  drop "want" from dk(0, 1), dk(2, 2)
  emit at (740, 196) "computed on the card"
  wait 700

  # Step 3: An expert that is not on the card runs on the host cores, at the same time.
  # It reads its weights from the mapping in place: they are never dequantised or copied.
  step 3
  view (16, 104, 628, 376) over 600ms
  readInto(dkAt(3, 2), 0, "pkc")
  addClass("run", query(".core"))
  let rd = packet(placeAt(3), "pkc")
  move rd along named("r-pc-core") speed 380
  remove rd
  emit at (270, 222) "read in place"
  wait 1300
  drop "run" from query(".core")
  drop "want" from dk(2, 3), dk(3, 2)

  # Step 4: The products of both sides are summed with the router's weights, and the stream goes on in the card.
  step 4
  view (336, 224, 652, 256) over 600ms
  cross((640, 350), (718, 350))
  emit at (352, 222) "weighted sum"
  wait 1200
end

scene disk
  loaded()
  cached()
  drop "in" from place(0), place(2), place(3), place(5)

  # Step 0: A page that is not in the RAM is read from the disk when a core touches it.
  # A fault reads 1 expert at a time.
  step 0
  view (16, 104, 628, 376) over 600ms
  addClass("want", dk(3, 2))
  addClass("run", query(".core"))
  wait 500
  readInto(dkAt(3, 2), 0, "pkc")
  drop "want" from dk(3, 2)
  emit at (270, 222) "1 expert per fault"
  wait 1000
  drop "run" from query(".core")

  # Step 1: Reader threads read the experts of the next layers before they are needed.
  # They guess them from the stream the token has by then.
  step 1
  view (16, 104, 628, 376) over 600ms
  addClass("want", dk(1, 3))
  addClass("want", dk(2, 5))
  addClass("want", dk(4, 1))
  together
    readInto(dkAt(1, 3), 3, "pkc")
  also
    wait 200
    readInto(dkAt(2, 5), 5, "pkc")
  also
    wait 400
    readInto(dkAt(4, 1), 7, "pkc")
  end
  drop "want" from dk(1, 3), dk(2, 5), dk(4, 1)
  emit at (270, 222) "read before it is needed"
  wait 1200

  # Step 2: How many layers ahead they read is moved by the decode's own timing.
  # A controller tries each neighbour for a window and keeps one only when the tokens run faster.
  step 2
  view (16, 104, 628, 376) over 600ms
  emit at (270, 222) "tries 1 layer ahead"
  wait 1500
  emit at (270, 222) "then 2, if faster"
  wait 1500

  # Step 3: The page cache keeps the experts used last.
  # The pages of the others are dropped only while the kernel reports memory stalls, and stay otherwise.
  step 3
  view (336, 224, 308, 256) over 600ms
  emit at (352, 222) "memory stalls: dropped"
  drop "in" from place(7)
  drop "in" from place(9)
  drop "in" from place(11)
  wait 1500
  emit at (352, 222) "no stalls: kept"
  addClass("in", place(7))
  addClass("in", place(9))
  addClass("in", place(11))
  wait 1300
end

scene card
  loaded()
  drop "in" from slot(17)
  drop "hot" from dk(4, 8)
  cached()

  # Step 0: An expert that is not on the card runs on the host, and the card counts each time it sees it.
  step 0
  view all
  addClass("want", dk(2, 4))
  emit at (36, 106) "seen 1 time"
  wait 900
  emit at (36, 106) "seen 2 times"
  wait 1000

  # Step 1: Once an expert was seen as many times as an upload needs uses to pay for itself, it is queued for the copy thread.
  # An upload costs a measured time, and each use on the card saves the measured time of the host.
  step 1
  view (336, 224, 652, 256) over 600ms
  emit at (352, 222) "an upload pays back"
  readInto(dkAt(2, 4), 2, "pkc")
  let d = packet(placeAt(2), "pk")
  move d via CACHE_OUT speed 460
  move d via STREAM speed 460
  remove d
  addClass("in", select("#cs-0"))
  wait 900

  # Step 2: The copy thread sends the expert on a stream of its own.
  # The copy goes beside the card's compute and off the token's path, so the token runs the expert on the host.
  step 2
  view (716, 196, 272, 284) over 600ms
  addClass("run", select("#cd-always"))
  let c = packet(STREAM, "pk")
  move c via slotAt(17) speed 380
  remove c
  drop "in" from select("#cs-0")
  addClass("in", slot(17))
  addClass("fresh", slot(17))
  emit at (740, 196) "off the token's path"
  wait 1300
  drop "run" from select("#cd-always")

  # Step 3: The card now holds the copy, so the host pages that were read for it are released.
  # They would take the room of experts that the host still needs.
  step 3
  view (16, 104, 628, 376) over 600ms
  drop "in" from place(2)
  addClass("hot", dk(2, 4))
  drop "want" from dk(2, 4)
  drop "fresh" from slot(17)
  emit at (270, 222) "pages released"
  wait 1300

  # Step 4: When the VRAM is full, a newcomer takes the place of the least frequently routed expert.
  # It never takes the place of an expert used within the layers of this token, and only of one colder than itself.
  step 4
  view (716, 196, 272, 284) over 600ms
  addClass("want", dk(1, 5))
  addClass("dim", slot(3))
  emit at (740, 196) "colder one gives way"
  wait 1100
  drop "in" from slot(3)
  drop "dim" from slot(3)
  drop "hot" from dk(0, 7)
  addClass("in", slot(3))
  addClass("fresh", slot(3))
  addClass("hot", dk(1, 5))
  drop "want" from dk(1, 5)
  wait 1200

  # Step 5: The heat of an evicted expert outlives its slot.
  # It comes back at the count it earned, so the slots settle on the hottest experts instead of churning.
  step 5
  view all
  drop "fresh" from slot(3)
  emit at (36, 106) "keeps its count"
  wait 1600
end

scene prompt
  loaded()
  cached()
  addClass("dim", query("[data-part=slab]"))

  # Step 0: A prompt routes its tokens to many experts in each layer.
  # The layer starts when the router has named them.
  step 0
  view (16, 104, 250, 376) over 600ms
  wait 400
  for r in range(5)
    for c in range(9)
      if (r * 9 + c) % 2 == 0
        addClass("want", dk(r, c))
      end
    end
  end
  emit at (36, 106) "the prompt's experts"
  wait 1300

  # Step 1: Each expert goes where it costs least.
  # An expert kept on a card runs there from the card's copy.
  # Another runs on a card when a copy of it costs less than its rows cost the host, and stays on the host otherwise.
  step 1
  view (336, 196, 652, 284) over 600ms
  drop "dim" from query("[data-part=slab]")
  wait 300
  for i in range(len(HOT))
    addClass("run", slot(i))
  end
  emit at (740, 196) "kept on the card"
  wait 700
  addClass("run", query(".core"))
  emit at (352, 222) "stays on the host"
  wait 1100

  # Step 2: The copies are read from the file into a page-locked slab, in runs of adjacent experts, around the page cache.
  step 2
  view (16, 104, 628, 376) over 600ms
  for k in range(4)
    addClass("want", dk(3, 2 + k))
  end
  together for k in range(4)
    wait k * 120
    let d = packet(dkAt(3, 2 + k), "pk")
    move d via (262, 360) speed 600
    move d along named("r-disk-slab") speed 560
    addClass("in", select("#sl-" + str(k)))
    remove d
  end
  emit at (270, 222) "1 read per run"
  wait 1100

  # Step 3: The card computes the experts it keeps and the copies, and the host computes its own.
  # All of it happens at the same time.
  step 3
  view (336, 196, 652, 284) over 600ms
  let m = packet((590, 436), "pk")
  move m along named("r-slab-lc") speed 520
  remove m
  addClass("in", select("#lc-0"))
  addClass("in", select("#lc-1"))
  wait 1300

  # Step 4: A copy made for the layer is let go after it unless the card has the room free to keep it.
  # Nothing is evicted for it: it never takes a kept expert's place.
  step 4
  view (716, 196, 272, 284) over 600ms
  drop "in" from select("#lc-0"), select("#lc-1")
  for k in range(4)
    drop "in" from select("#sl-" + str(k))
  end
  drop "run" from query(".cd")
  drop "run" from query(".core")
  emit at (740, 196) "let go after the layer"
  wait 1300

  # Step 5: When the cards take no part of the prompt and it routes to most of the experts, whole layers are read in.
  # The next layer is read into the RAM while the current layer computes.
  step 5
  view (16, 104, 628, 376) over 600ms
  for k in range(4)
    addClass("run", query(".core"))
  end
  together for i in range(6)
    wait i * 140
    readInto(dkAt(1 + floor(i / 3), 2 + i % 3), 9 + i, "pkc")
  end
  emit at (270, 222) "the next layer, read in"
  wait 1300
  drop "run" from query(".core")
end
