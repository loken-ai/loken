# The same model and the same server given to 3 engines.
# A layer is a slab of the strip. A place of a device is a square. A request is a gold slab.
# What a row of vLLM or Ollama does is read from their code and documentation. The row of loken is what loken does.

let ROWS = ["vllm", "ollama", "loken"]
let Y0 = {vllm: 100, ollama: 250, loken: 400}
let DX = [330, 496, 662]
let COLS = [4, 4, 3]

# The place `n` of the device `d` in the row `r`.
to cell(r, d, n)
  return select("#c-" + r + "-" + str(d) + "-" + str(n))
end

# The middle of the place `n` of the device `d` in the row `r`.
to cellAt(r, d, n)
  let cols = COLS[d]
  return (DX[d] + 26 + (n % cols) * 34, Y0[r] + 55 + floor(n / cols) * 32)
end

# The layer `k` of the strip of the row `r`.
to layer(r, k)
  return select("#ly-" + r + "-" + str(k))
end

# The middle of the layer `k` of the strip of the row `r`.
to layerAt(r, k)
  return (122 + k * 25, Y0[r] + 63)
end

# The layer `k` of the row `r` goes to the place `n` of the device `d`, which takes the class `look`.
to put(r, k, d, n, look)
  let a = layerAt(r, k)
  let b = cellAt(r, d, n)
  let p = dot(a[0], a[1], 8, "pl")
  addClass("moved", layer(r, k))
  move p via b speed 560
  remove p
  addClass(look, cell(r, d, n))
end

# Layers `a` up to `b`, one after the other, go to the places of the device `d` from `first`.
to fill(r, a, b, d, first, look)
  for k in range(a, b)
    put(r, k, d, first + k - a, look)
  end
end

# The device `d` of the row `r` is named and holds only `n` places.
to device(r, d, name, n, kind)
  retext(named("devname-" + r + "-" + str(d)), name)
  if kind
    addClass(kind, select("#dv-" + r + "-" + str(d)))
  end
  for i in range(n, COLS[d] * 2)
    addClass("gone", cell(r, d, i))
  end
end

# The note of the row `r`, and the camera on its strip and its first places.
to note(r, text)
  retext(named("note-" + r), text)
  focus(r, "left")
end

# The camera on the left or on the right of the row `r`, in a narrow column.
to focus(r, side)
  if side == "left"
    view (6, Y0[r] - 4, 480, 150) over 500ms
  else
    view (320, Y0[r] - 4, 480, 150) over 500ms
  end
end

# The note of the device `d` of the row `r`.
to devnote(r, d, text)
  retext(named("devnote-" + r + "-" + str(d)), text)
end

# The row `r` ends well, with a tick, or stopped, with a cross.
to verdict(r, good)
  focus(r, "right")
  if good
    addClass("gone", named("stop-" + r))
    dropClass("gone", named("ok-" + r))
  else
    addClass("gone", named("ok-" + r))
    dropClass("gone", named("stop-" + r))
  end
end

# Every row has the same devices at the start of a scene.
to setup(name0, n0, kind0, name1, n1, kind1, name2, n2, kind2)
  for r in ROWS
    device(r, 0, name0, n0, kind0)
    device(r, 1, name1, n1, kind1)
    if n2 > 0
      device(r, 2, name2, n2, kind2)
    else
      addClass("gone", named("dev-" + r + "-2"))
    end
  end
end

scene room
  setup("CARD", 5, none, "HOST MEMORY", 8, "hostc", "", 0, none)
  for r in ROWS
    devnote(r, 0, "holds 5 layers")
  end

  # Step 0: The model has 8 layers and the card holds 5. The host has room for the others.
  step 0
  view all
  wait 1200

  # Step 1: vLLM loads the weights on the card.
  # Host memory holds weights only when cpu_offload_gb is set, and its default is 0.
  step 1
  note("vllm", "cpu_offload_gb = 0 (default)")
  fill("vllm", 0, 5, 0, 0, "in")
  for k in range(5, 8)
    addClass("stuck", layer("vllm", k))
  end
  emit at (112, 196) "no room for 3 layers"
  focus("vllm", "right")
  wait 1400

  # Step 2: With cpu_offload_gb set by the owner, a part of the weights is read from host memory at each forward pass.
  # That asks for a fast link between the host and the card.
  step 2
  note("vllm", "cpu_offload_gb set by owner")
  for k in range(5, 8)
    dropClass("stuck", layer("vllm", k))
  end
  fill("vllm", 5, 8, 1, 0, "inh")
  devnote("vllm", 1, "read at each pass")
  wait 1400

  # Step 3: At start vLLM also checks that the KV cache of 1 request, at the model's maximum length, fits in what is left.
  # If it does not, the start stops with an error that names the settings to change.
  step 3
  devnote("vllm", 0, "KV cache: no room")
  verdict("vllm", false)
  note("vllm", "stops: KV cache too big")
  wait 1800

  # Step 4: Ollama runs the model in llama-server, which decides the number of layers on the card unless num_gpu is set.
  # The other layers run on the host.
  step 4
  note("ollama", "num_gpu unset: auto")
  fill("ollama", 0, 5, 0, 0, "in")
  fill("ollama", 5, 8, 1, 0, "inh")
  verdict("ollama", true)
  wait 1600

  # Step 5: Loken fills the card with the layers it holds, and the host takes only the layers that no card holds.
  step 5
  note("loken", "the host takes only the rest")
  fill("loken", 0, 5, 0, 0, "in")
  fill("loken", 5, 8, 1, 0, "inh")
  verdict("loken", true)
  wait 1500

  # Step 6: Only if that placement fails with an out-of-memory error does loken try the next rung of a ladder.
  # The rungs go from an even split, to the cards at a smaller share with the host, to the host alone.
  step 6
  note("loken", "only after a failure")
  emit at (112, 496) "out of memory"
  wait 900
  for n in range(5)
    dropClass("in", cell("loken", 0, n))
  end
  for n in range(3)
    dropClass("inh", cell("loken", 1, n))
  end
  for k in range(0, 8)
    dropClass("moved", layer("loken", k))
  end
  note("loken", "next rung: card + host")
  fill("loken", 0, 4, 0, 0, "in")
  fill("loken", 4, 8, 1, 0, "inh")
  wait 1600
end

scene cards
  setup("CARD A, FAST", 5, none, "CARD B, SLOW", 5, none, "", 0, none)

  # Step 0: No card holds the 8 layers alone, and the 2 cards together do.
  # Card A is faster than card B.
  step 0
  view all
  wait 1200

  # Step 1: In vLLM, tensor_parallel_size and pipeline_parallel_size are set by the owner, and both default to 1.
  step 1
  note("vllm", "tensor_parallel_size = 1")
  fill("vllm", 0, 5, 0, 0, "in")
  for k in range(5, 8)
    addClass("stuck", layer("vllm", k))
  end
  focus("vllm", "right")
  wait 1500

  # Step 2: With tensor_parallel_size set to 2, each layer is split across both cards.
  step 2
  note("vllm", "tensor_parallel_size = 2")
  for k in range(5, 8)
    dropClass("stuck", layer("vllm", k))
  end
  for n in range(5)
    dropClass("in", cell("vllm", 0, n))
  end
  for k in range(0, 8)
    dropClass("moved", layer("vllm", k))
  end
  for k in range(0, 8)
    put("vllm", k, 0, floor(k / 2), "in")
    put("vllm", k, 1, floor(k / 2), "in")
  end
  verdict("vllm", true)
  wait 1200

  # Step 3: Ollama loads the model on 1 GPU when it fits there entirely, and spreads it across all the available GPUs when it does not.
  step 3
  note("ollama", "does not fit 1 GPU: spread")
  fill("ollama", 0, 4, 0, 0, "in")
  fill("ollama", 4, 8, 1, 0, "in")
  verdict("ollama", true)
  wait 1500

  # Step 4: Loken ranks the cards by compute rate and fills them in that order until every layer has a card.
  # The layers are then shared out by rate, so the faster card holds more.
  step 4
  note("loken", "ranked by compute rate")
  devnote("loken", 0, "rank 1")
  devnote("loken", 1, "rank 2")
  fill("loken", 0, 5, 0, 0, "in")
  fill("loken", 5, 8, 1, 0, "in")
  verdict("loken", true)
  wait 1500

  # Step 5: When the model fits no card and every layer can be split, loken splits every layer across the cards if that is predicted faster.
  step 5
  note("loken", "split every layer, if faster")
  for n in range(5)
    dropClass("in", cell("loken", 0, n))
  end
  for n in range(3)
    dropClass("in", cell("loken", 1, n))
  end
  for n in range(4)
    addClass("in", cell("loken", 0, n))
    addClass("in", cell("loken", 1, n))
    addClass("half", cell("loken", 0, n))
    addClass("half", cell("loken", 1, n))
  end
  wait 1600
end

scene machines
  setup("MACHINE A: CARD", 5, none, "MACHINE A: HOST", 8, "hostc", "MACHINE B", 6, "remotec")

  # Step 0: A model that no card holds alone, on 2 machines linked by a network.
  step 0
  view all
  wait 1200

  # Step 1: In vLLM, the owner sets nnodes and the parallel sizes, and picks the ray or the mp executor backend.
  step 1
  note("vllm", "nnodes = 2, ray or mp")
  fill("vllm", 0, 5, 0, 0, "in")
  fill("vllm", 5, 8, 2, 0, "inr")
  verdict("vllm", true)
  wait 1500

  # Step 2: Ollama reads the video memory and the system memory of the machine it runs on, and places the model there.
  step 2
  note("ollama", "the machine it runs on")
  fill("ollama", 0, 5, 0, 0, "in")
  fill("ollama", 5, 8, 1, 0, "inh")
  addClass("dim", named("dev-ollama-2"))
  verdict("ollama", true)
  wait 1500

  # Step 3: In loken, any machine of the cluster can receive a request.
  # It predicts the completion time here and on its peer, and sends the whole request to the peer when the peer wins by a margin.
  step 3
  note("loken", "forward to faster peer")
  devnote("loken", 2, "serves the same model")
  view all
  let q = dot(300, 468, 8, "rq")
  move q via (420, 470), (700, 470) speed 320
  emit at (520, 500) "to the peer"
  wait 800
  remove q
  wait 700

  # Step 4: A model larger than a machine can be cut across 2 machines.
  # Each machine runs 1 run of layers, on its cards first, and the cut is the one with the shortest predicted time for 1 token.
  step 4
  devnote("loken", 2, "")
  note("loken", "cut: shortest token time")
  fill("loken", 0, 5, 0, 0, "in")
  fill("loken", 5, 8, 2, 0, "inr")
  verdict("loken", true)
  wait 1600
end

scene parallel
  for r in ROWS
    retext(named("strip-" + r), "3 REQUESTS")
    for k in range(3, 8)
      addClass("gone", layer(r, k))
    end
    for k in range(0, 3)
      addClass("req", layer(r, k))
    end
    device(r, 0, "RUNNING TOGETHER", 8, none)
    device(r, 1, "WAITING", 8, "hostc")
    device(r, 2, "CONTEXT", 6, "hostc")
  end

  # Step 0: 3 requests reach the same model together.
  step 0
  view all
  wait 1200

  # Step 1: vLLM batches the running requests in its scheduler, step by step, up to max_num_seqs sequences, 128 by default.
  step 1
  note("vllm", "max_num_seqs = 128 (default)")
  fill("vllm", 0, 3, 0, 0, "in")
  verdict("vllm", true)
  wait 1500

  # Step 2: Ollama serves OLLAMA_NUM_PARALLEL requests per model at a time, 1 by default, and queues the others.
  # The memory for the context grows with each parallel request.
  step 2
  note("ollama", "NUM_PARALLEL = 1 (default)")
  put("ollama", 0, 0, 0, "in")
  put("ollama", 1, 1, 0, "inh")
  put("ollama", 2, 1, 1, "inh")
  addClass("inh", cell("ollama", 2, 0))
  wait 1100
  note("ollama", "NUM_PARALLEL = 3")
  dropClass("inh", cell("ollama", 1, 0))
  dropClass("inh", cell("ollama", 1, 1))
  addClass("in", cell("ollama", 0, 1))
  addClass("in", cell("ollama", 0, 2))
  addClass("inh", cell("ollama", 2, 1))
  addClass("inh", cell("ollama", 2, 2))
  verdict("ollama", true)
  wait 1400

  # Step 3: Loken serves 1 request at a time until 1 arrives while another runs.
  # Then the model batches its requests in its worker, and a run of lone requests brings it back to serial.
  step 3
  note("loken", "serial / batch / serial")
  put("loken", 0, 0, 0, "in")
  wait 600
  put("loken", 1, 0, 1, "in")
  put("loken", 2, 0, 2, "in")
  note("loken", "a request overlapped: batch")
  wait 1000
  for n in range(1, 3)
    dropClass("in", cell("loken", 0, n))
  end
  note("loken", "lone: back to serial")
  verdict("loken", true)
  wait 1400
end
