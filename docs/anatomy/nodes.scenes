# The scenes of 2 nodes on the banks of a river, the network.
# A train is a request, or 1 pass of the model through the layers.
# forward: node A prices both nodes, and the request crosses whole to node B.
# pipeline: the layers are cut between the nodes, and 1 train makes 1 lap for each token.
# prefill: node B reads the prompt, and its KV cache crosses back to node A as freight.

# Every element the stories change starts as drawn, whatever ran before: a replay, a jump or another scene.
# The reset lands at once, with no fade.
addClass("nd-instant", named("world"))
later 80ms
  dropClass("nd-instant", named("world"))
end
for c in ["on", "go", "stop", "set", "busy", "relay", "pass", "send", "gone", "dim", "ok", "eval", "full", "hit", "a-card", "a-host", "b-card", "b-host"]
  dropClass(c, query("*"))
end
for k in ["a", "b"]
  retext(named("tagc-" + k), "CARD ?")
  retext(named("tagh-" + k), "HOST ?")
end
retext(named("rtt-text"), "ROUND TRIP 5 MS")
retext(named("lapnote"), "PER TOKEN, PREDICTED")
retext(named("lapms"), "")
retext(named("lapparts"), "NO CUT PLANNED YET")
retext(named("dock-n1"), "")
retext(named("pa"), "NODE A")
retext(named("pb"), "NODE B")
setAttr(named("rate-peer"), "width", 0)
setAttr(named("rate-here"), "width", 0)
setAttr(named("bw-in"), "transform", "translate(178 0)")
setAttr(named("cut"), "transform", "translate(0 0)")
setAttr(named("sw-hand"), "transform", "rotate(0 642 108)")

let PI = 3.14159265
let TOP = 200
let BOT = 420
let JA = 290
let JB = 735
# The length of 1 layer on a loop.
let U = 11
let LAYERS = 48
let DEMO = {prompt: ["What", " is", " the", " capital", " of", " France", "?"], answer: ["The", " capital", " is", " Paris", "."]}
# The pace of a train on plain track, in units of the figure per second.
let FREE = 700
let S = {said: "", lap: 0, timing: false, laps: 1}
# The example plan: node A holds 22 layers on its cards and node B 20, each runs the rest on its host.
let PL = {cardA: 22, cardB: 20, msA: 1.0, msB: 1.5, hostA: 5.0, hostB: 7.0, rtt: 5, cut: 28}

# ---- Routes: lists of straight and circular pieces. ------------------------------------------

to L(x0, y0, x1, y1)
  return {k: "L", x0: x0, y0: y0, x1: x1, y1: y1, len: hypot(x1 - x0, y1 - y0), pace: FREE, cost: 0, tag: ""}
end

# An arc of centre (cx, cy) from the angle a0, turning by da: a positive da turns clockwise on screen.
to A(cx, cy, r, a0, da)
  return {k: "A", cx: cx, cy: cy, r: r, a0: a0, da: da, len: abs(da) * r, pace: FREE, cost: 0, tag: ""}
end

# The point of piece g at d from its start, with the direction of travel there.
to segAt(g, d)
  if g.k == "L"
    let t = d / g.len
    return [g.x0 + (g.x1 - g.x0) * t, g.y0 + (g.y1 - g.y0) * t, (g.x1 - g.x0) / g.len, (g.y1 - g.y0) / g.len]
  end
  let an = g.a0 + g.da * d / g.len
  let sg = 1 if g.da > 0 else -1
  return [g.cx + g.r * cos(an), g.cy + g.r * sin(an), -sin(an) * sg, cos(an) * sg]
end

to spot(route, s)
  let rest = max(s, 0)
  for g in route
    if rest <= g.len
      return segAt(g, rest)
    end
    rest = rest - g.len
  end
  let g = route[len(route) - 1]
  return segAt(g, g.len)
end

to segOf(route, s)
  let rest = max(s, 0)
  for g in route
    if rest < g.len
      return g
    end
    rest = rest - g.len
  end
  return route[len(route) - 1]
end

to total(route)
  let n = 0
  for g in route
    n = n + g.len
  end
  return n
end

# The model time spent between s0 and s1 of a route.
to costBetween(route, s0, s1)
  let acc = 0
  let ms = 0
  for g in route
    let a0 = max(s0, acc)
    let a1 = min(s1, acc + g.len)
    if a1 > a0
      ms = ms + (a1 - a0) * g.cost
    end
    acc = acc + g.len
  end
  return ms
end

# Where a route reaches x on its piece number i, a straight piece.
to sAtX(route, i, x)
  let acc = 0
  for j in range(i)
    acc = acc + route[j].len
  end
  return acc + abs(x - route[i].x0)
end

# Where a route reaches x on the straight piece tagged `tag`.
to sAt(route, tag, x)
  for [i, g] in enumerate(route)
    if g.tag == tag
      return sAtX(route, i, x)
    end
  end
  return 0
end

# Tags the piece g, for `sAt`.
to T(g, tag)
  g.tag = tag
  return g
end

# ---- Trains. ---------------------------------------------------------------------------------

to orient(el, p)
  setAttr(el, "transform", "matrix(" + fixed(p[2], 3) + " " + fixed(p[3], 3) + " " + fixed(-p[3], 3) + " " + fixed(p[2], 3) + " " + fixed(p[0], 1) + " " + fixed(p[1], 1) + ")")
end

# Sets every car on the route, the locomotive at s, and each piece of cargo on its car.
to put(tr, s)
  tr.s = s
  let acc = []
  for [i, car] in enumerate(tr.cars)
    let p = spot(tr.r, s - tr.gaps[i])
    orient(car, p)
    acc = acc + [p]
  end
  for c in tr.cargo
    let p = acc[c.car]
    orient(c.el, [p[0] + p[2] * c.u - p[3] * c.v, p[1] + p[3] * c.u + p[2] * c.v, p[2], p[3]])
  end
end

# A locomotive and its cars, `kinds` naming the sprite of each car, `gap` apart.
to train(route, s, kinds, cls, gap)
  let cars = [sprite("loco", (-99, -99))]
  let gaps = [0]
  for [i, k] in enumerate(kinds)
    cars = cars + [sprite(k, (-99, -99))]
    gaps = gaps + [gap * (i + 1) + 2]
  end
  addClass(cls, cars)
  let tr = {cars: cars, gaps: gaps, r: route, s: s, cargo: []}
  put(tr, s)
  return tr
end

# Runs the train to s1 acc the pace of the piece it is on, easing in and out.
# With S.timing, the stopwatch counts the model time of the pieces the locomotive crosses.
to roll(tr, s1)
  let t0 = clock()
  let last = t0
  while tr.s < s1
    wait 16
    let now = clock()
    let dt = now - last
    last = now
    let g = segOf(tr.r, tr.s)
    let ease = min(1, 0.25 + (now - t0) / 500) * min(1, 0.2 + (s1 - tr.s) / 50)
    let ns = min(s1, tr.s + g.pace * S.laps * ease * dt / 1000)
    if S.timing
      S.lap = S.lap + costBetween(tr.r, tr.s, ns)
      showLap()
    end
    put(tr, ns)
  end
end

to fadeOut(things)
  addClass("gone", things)
  wait 450
  remove things
end

# ---- Words and dials. ------------------------------------------------------------------------

to tokenWord(n, x, y)
  emit at (x, y) trim(DEMO.answer[n])
  S.said = S.said + DEMO.answer[n]
  row 1 S.said
  rowNote(1, "token " + str(n + 1) + " of " + str(len(DEMO.answer)))
end

# An arc of the clock of a station, from the share `f0` of the face, `share` long.
to dialArc(key, cls, f0, share)
  let c = (275, 522) if key == "a" else (755, 522)
  let r = 15
  let circ = 2 * PI * r
  let arc = shape("circle", {class: "rt-arc " + cls, cx: c[0], cy: c[1], r: r, transform: "rotate(-90 " + str(c[0]) + " " + str(c[1]) + ")", "stroke-dasharray": "0 " + fixed(circ, 2)})
  let t0 = clock()
  let u = 0
  while u < 1
    wait 16
    u = min(1, (clock() - t0) / 700)
    setAttr(arc, "stroke-dasharray", "0 " + fixed(f0 * circ, 2) + " " + fixed(share * circ * u, 2) + " " + fixed(circ, 2))
  end
  return arc
end

# ---- Loops of layers. ------------------------------------------------------------------------

to loopD(jx, r)
  let a = fixed(r, 2) + "," + fixed(r, 2) + " 0 1 1 "
  return "M" + str(jx) + "," + str(TOP) + " A" + a + str(jx) + "," + fixed(TOP + 2 * r, 2) + " A" + a + str(jx) + "," + str(TOP)
end

# Redraws the loop of node `key` for `card` layers on its cards and `host` on its host.
to shapeLoop(key, card, host)
  let n = card + host
  let jx = JA if key == "a" else JB
  let g = named("loop-" + key)
  if n == 0
    addClass("gone", g)
    return none
  end
  dropClass("gone", g)
  let r = n * U / (2 * PI)
  let d = loopD(jx, r)
  for p in query(".nd-lp-" + key)
    setAttr(p, "d", d)
  end
  let c = 2 * PI * r
  setAttr(named("card-" + key), "stroke-dasharray", fixed(card * U, 1) + " " + fixed(c + 10, 1))
  setAttr(named("host-" + key), "stroke-dasharray", "0 " + fixed(card * U, 1) + " " + fixed(host * U, 1) + " " + fixed(c + 10, 1))
  let low = 0 if r > 55 else r + 18
  setAttr(named("lt-" + key), "y", fixed(TOP + r + 3 + low, 1))
  setAttr(named("ls-" + key), "y", fixed(TOP + r + 19 + low, 1))
  retext(named("ls-" + key), str(n) + " LAYERS")
end

# The pieces of 1 lap of a loop: its card layers, then its host layers.
to loopPieces(key, card, host, cardMs, hostMs)
  let n = card + host
  if n == 0
    return []
  end
  let jx = JA if key == "a" else JB
  let r = n * U / (2 * PI)
  let out = []
  if card > 0
    let g = A(jx, TOP + r, r, -PI / 2, 2 * PI * card / n)
    g.cost = cardMs / U
    g.pace = U / (cardMs * 0.05)
    out = out + [g]
  end
  if host > 0
    let h = A(jx, TOP + r, r, -PI / 2 + 2 * PI * card / n, 2 * PI * host / n)
    h.cost = hostMs / U
    h.pace = U / (hostMs * 0.05)
    out = out + [h]
  end
  return out
end

# A bridge piece: slow, and it costs half the round trip.
to bridge(x0, x1, y)
  let g = L(x0, y, x1, y)
  g.pace = 150
  g.cost = PL.rtt / 2 / 128
  return g
end

# Node A takes layers 0 to k - 1, node B the rest: each fills its cards, then its host.
to split(k)
  let m = LAYERS - k
  return {ac: min(k, PL.cardA), ah: max(0, k - PL.cardA), bc: min(m, PL.cardB), bh: max(0, m - PL.cardB)}
end

# The predicted time of 1 token for the cut k: the compute of each node, plus the crossing.
to lapOf(k)
  let p = split(k)
  let x = p.ac * PL.msA + p.ah * PL.hostA
  let y = p.bc * PL.msB + p.bh * PL.hostB
  let c = PL.rtt if k < LAYERS else 0
  return {a: x, b: y, cross: c, all: x + y + c}
end

# The loop line from node A's platform, through both loops, back to the platform.
to lapRoute(k)
  let p = split(k)
  let out = [L(300, BOT, 120, BOT), A(120, BOT - 50, 50, PI / 2, PI / 2), L(70, BOT - 50, 70, TOP + 50), A(120, TOP + 50, 50, PI, PI / 2), L(120, TOP, JA, TOP)]
  out = out + loopPieces("a", p.ac, p.ah, PL.msA, PL.hostA)
  out = out + [T(L(JA, TOP, 456, TOP), "a-out"), bridge(456, 584, TOP), T(L(584, TOP, JB, TOP), "b-in")]
  out = out + loopPieces("b", p.bc, p.bh, PL.msB, PL.hostB)
  out = out + [T(L(JB, TOP, 900, TOP), "b-out"), A(900, TOP + 50, 50, -PI / 2, PI / 2), L(950, TOP + 50, 950, BOT - 50), A(900, BOT - 50, 50, 0, PI / 2), L(900, BOT, 584, BOT), bridge(584, 456, BOT), L(456, BOT, 300, BOT)]
  return out
end

# Shows the cut k on the planner, the loops and the stopwatch.
to showPlan(k)
  let p = split(k)
  for i in range(LAYERS)
    let c = named("cell" + str(i))
    for x in ["a-card", "a-host", "b-card", "b-host"]
      dropClass(x, c)
    end
    if i < k
      addClass("a-card" if i < PL.cardA else "a-host", c)
    else
      addClass("b-card" if i - k < PL.cardB else "b-host", c)
    end
  end
  setAttr(named("cut"), "transform", "translate(" + str((k - PL.cut) * 8) + " 0)")
  retext(named("pa"), "NODE A: 0 TO " + str(k - 1))
  retext(named("pb"), ("NODE B: " + str(k) + " TO 47") if k < LAYERS else "NODE B: NONE")
  shapeLoop("a", p.ac, p.ah)
  shapeLoop("b", p.bc, p.bh)
  let t = lapOf(k)
  S.lap = t.all
  showLap()
  retext(named("lapparts"), "A " + fixed(t.a, 0) + " + CROSSING " + str(t.cross) + " + B " + fixed(t.b, 0))
end

to showLap()
  retext(named("lapms"), fixed(S.lap, 0) + " MS")
  setAttr(named("sw-hand"), "transform", "rotate(" + fixed(S.lap / 160 * 360, 1) + " 642 108)")
end

# ---- Crates, the dock and the rack. ----------------------------------------------------------

to slotAt(i)
  return (399.5 + (i % 4) * 14.5, 485.5 + floor(i / 4) * 15)
end

to bayAt(i)
  let b = floor(i / 4)
  let j = i % 4
  return (38 + (b % 2) * 66 + 21 + (j % 2) * 16, 482 + floor(b / 2) * 40 + 10 + floor(j / 2) * 14)
end

# Lifts sprites to their points together, upright, along a small hop.
to carry(moves, ms)
  let origin = [centre(m[0]) for m in moves]
  let t0 = clock()
  let u = 0
  while u < 1
    wait 16
    u = min(1, (clock() - t0) / ms)
    let e = u * u * (3 - 2 * u)
    for [i, m] in enumerate(moves)
      let a = origin[i]
      let b = m[1]
      setAttr(m[0], "transform", "translate(" + fixed(a[0] + (b[0] - a[0]) * e, 1) + " " + fixed(a[1] + (b[1] - a[1]) * e - sin(e * PI) * 18, 1) + ")")
    end
  end
end

# ======================================================================================== scenes

scene forward
  # Node A receives a chat request, prices itself and node B, and forwards the request whole.
  let cv = 74
  let th = 1.2405
  let R = [L(-200, 300, 190, 300), A(190, 300 - cv, cv, PI / 2, -th), A(330, TOP + cv, cv, -PI / 2 - th, th), L(330, TOP, 900, TOP), A(900, TOP + 50, 50, -PI / 2, PI / 2), L(950, TOP + 50, 950, BOT - 50), A(900, BOT - 50, 50, 0, PI / 2), L(900, BOT, -200, BOT)]
  # The frames of the camera, in a narrow column: the client, the gauge, node B and the way back.
  let VC = (0, 190, 436, 381)
  let VG = (12, 0, 436, 381)
  let VB = (553, 150, 436, 381)
  let VR = (0, 260, 436, 381)
  let t = train(R, 0, ["wagon", "wagon"], "req", 40)
  add "stop" to named("signal")

  # Step 0: A chat request reaches any machine of the cluster.
  step 0
  view VC over 500ms
  roll(t, sAtX(R, 0, 150))
  emit at (120, 266) "any machine"
  wait 500

  # Step 1: Node A predicts the time here and on node B, round trip included.
  step 1
  view (52, 330, 436, 381) over 500ms
  say "Node A predicting its own completion time" busy
  let aw = dialArc("a", "work", 0, 0.9)
  add "on" to named("here-ms")
  emit at (275, 395) "900 ms here"
  wait 300
  view (297, 60, 436, 381) over 500ms
  say "The polls between machines time the round trip" busy
  let pr = sprite("probe", (330, TOP))
  move pr along "M330,200 L700,200" speed 320
  emit at (520, 245) "round trip"
  move pr along "M700,200 L330,200" speed 320
  remove pr
  view (530, 330, 436, 381) over 500ms
  let br = dialArc("b", "rtt", 0, 0.09)
  add "on" to named("bwagon")
  say "Node A predicting the time on node B" busy
  let bw = dialArc("b", "work", 0.09, 0.36)
  emit at (755, 395) "360 + 90 ms"
  add "on" to named("bar-ms")
  wait 300
  view VG over 500ms
  wait 500

  # Step 2: Node B wins when its estimate fits under the local estimate divided by min_speedup.
  step 2
  view VG over 500ms
  say "Node B rolls to the gauge" busy
  let g = named("bw-in")
  let t0 = clock()
  let u = 0
  while u < 1
    wait 16
    u = min(1, (clock() - t0) / 1600)
    setAttr(g, "transform", "translate(" + fixed(178 + 144 * u * u * (3 - 2 * u), 1) + " 0)")
  end
  add "go" to named("glamp")
  tone(1320, 60, "triangle", 0.08)
  emit at (110, 70) "fits under"
  add "on" to named("verdict")
  wait 700

  # Step 3: The request goes to node B whole, and its stream comes back through node A.
  step 3
  drop "stop" from named("signal")
  add "go" to named("signal")
  add "set" to named("s-b")
  add "on" to named("lit-b")
  view VB over 600ms
  say "Forwarding the request whole to node B" busy
  roll(t, sAtX(R, 7, 650))
  add "busy" to named("st-b")
  add "on" to named("lit-back")
  say "Node B decodes, node A relays its stream" busy
  view VR over 900ms
  together for n in range(len(DEMO.answer))
    wait n * 700
    let k = sprite("tok", (-99, -99))
    let tr = {cars: [k], gaps: [0], r: [L(640, BOT, -60, BOT)], s: 0, cargo: []}
    put(tr, 0)
    roll(tr, 340)
    add "relay" to named("st-a")
    if n == 0
      emit at (275, 398) "relayed by node A"
    end
    later 300
      drop "relay" from named("st-a")
    end
    roll(tr, 620)
    tokenWord(n, 44, 400)
    remove k
  end
  drop "busy" from named("st-b")
  say "Answer relayed to the client"
  wait 600
end

scene pipeline
  # The layers are cut between node A and node B, and each token makes 1 lap of the line.
  showPlan(LAYERS)
  retext(named("pa"), "NODE A: 0 TO 47")
  retext(named("pb"), "NODE B: ITS OWN COPY")
  shapeLoop("b", PL.cardB, LAYERS - PL.cardB)
  retext(named("lapms"), "")
  retext(named("lapparts"), "NO CUT PLANNED YET")
  addClass("dim", query(".nd-lp-b.nd-arc"))
  addClass("dim", query(".nd-lp-b.nd-ticks"))
  # The frames of the camera, in a narrow column.
  let VA = (40, 180, 436, 381)
  let VBb = (553, 180, 436, 381)
  let VRiv = (297, 150, 436, 381)
  let VP = (12, 0, 436, 381)
  let VS = (553, 0, 436, 381)
  let VH = (60, 260, 436, 381)

  # Step 0: The machine that loads the model times a layer on its cards and on its host.
  step 0
  view VA over 500ms
  add "busy" to named("st-a")
  add "on" to named("tag-a")
  let rW = LAYERS * U / (2 * PI)
  let one = [L(200, TOP, JA, TOP), A(JA, TOP + rW, rW, -PI / 2, U / rW)]
  one[1].pace = 26
  let sh = train(one, 0, [], "shunt", 0)
  roll(sh, total(one))
  retext(named("tagc-a"), "CARD 1.0 MS")
  emit at (JA, 393) "1 layer on cards"
  let ang = -PI / 2 + 2 * PI * PL.cardA / LAYERS
  let hostOne = [A(JA, TOP + rW, rW, ang - 0.6, 0.6), A(JA, TOP + rW, rW, ang, U / rW)]
  hostOne[1].pace = 7
  sh.r = hostOne
  put(sh, 0)
  roll(sh, total(hostOne))
  retext(named("tagh-a"), "HOST 5.0 MS")
  emit at (100, 393) "1 layer on host"
  fadeOut(sh.cars)
  drop "busy" from named("st-a")

  # Step 1: Every machine publishes its figures, and each poll times the round trip.
  step 1
  view VBb over 500ms
  retext(named("tagc-b"), "CARD 1.5 MS")
  retext(named("tagh-b"), "HOST 7.0 MS")
  add "on" to named("tag-b")
  wait 700
  view VRiv over 500ms
  for i in range(2)
    let pa = sprite("probe", (420, TOP))
    let pb = sprite("probe", (620, BOT))
    together
      move pa along "M420,200 L620,200" speed 300
      move pa along "M620,200 L420,200" speed 300
    also
      move pb along "M620,420 L420,420" speed 300
      move pb along "M420,420 L620,420" speed 300
    end
    remove pa, pb
  end
  add "on" to named("flood-top"), named("flood-bot"), named("rtt-tag")
  retext(named("rtt-text"), "ROUND TRIP 5 MS")
  wait 500

  # Step 2: The planner gives each machine 1 contiguous run, and keeps the cut of the shortest lap.
  step 2
  view VP over 500ms
  dropClass("dim", query(".nd-arc"))
  dropClass("dim", query(".nd-ticks"))
  add "on" to named("cut")
  retext(named("lapnote"), "TRYING EVERY CUT")
  showPlan(LAYERS)
  wait 800
  for k in [46, 44, 42, 40, 38, 36, 34, 32, 30, 28, 26, 24, 22, 20, 18, 16]
    showPlan(k)
    tone(400 + k * 10, 30, "sine", 0.03)
    wait 150
  end
  for k in [18, 20, 22, 24, 26, 28]
    showPlan(k)
    wait 120
  end
  retext(named("lapnote"), "SHORTEST LAP, PER TOKEN")
  view VS over 600ms
  emit at (590, 362) "best cut"
  tone(1320, 60, "triangle", 0.08)
  wait 600

  # Step 3: Each machine reloads its share from its own copy of the model file.
  step 3
  view VA over 500ms
  wait 600
  add "gone" to named("loop-a"), named("loop-b")
  wait 400
  add "send" to named("shed-a"), named("shed-b")
  let pc = split(PL.cut)
  let rA = (pc.ac + pc.ah) * U / (2 * PI)
  let rB = (pc.bc + pc.bh) * U / (2 * PI)
  let boxA = [sprite("crate", (144, 360)) for i in range(5)]
  let boxB = [sprite("crate", (880, 360)) for i in range(5)]
  carry([[b, (JA + (i - 2) * 12, TOP + rA)] for [i, b] in enumerate(boxA)] + [[b, (JB + (i - 2) * 12, TOP + rB)] for [i, b] in enumerate(boxB)], 1000)
  addClass("gone", boxA + boxB)
  drop "gone" from named("loop-a"), named("loop-b")
  drop "send" from named("shed-a"), named("shed-b")
  emit at (JA, 360) "layers 0 to 27"
  view VBb over 600ms
  emit at (640, 385) "layers 28 to 47"
  wait 700
  remove boxA, boxB

  # Step 4: A lap first carries the prompt, a whole prefill chunk in 1 frame.
  step 4
  let R = lapRoute(PL.cut)
  let cv = train(R, 0, ["tok", "tok", "tok", "tok", "tok", "tok", "tok"], "coach", 24)
  view VA over 500ms
  say "Node A runs its layers on every prompt token" busy
  add "busy" to named("st-a")
  roll(cv, sAt(R, "a-out", 440))
  drop "busy" from named("st-a")
  add "pass" to named("flood-top")
  view VRiv over 500ms
  say "The activations of every prompt token cross the river" busy
  roll(cv, sAt(R, "b-in", 640))
  drop "pass" from named("flood-top")
  add "busy" to named("st-b")
  view VBb over 500ms
  say "Node B runs the last layers" busy
  roll(cv, sAt(R, "b-out", 880))
  drop "busy" from named("st-b")
  say "Node B answers with the logits of the last token" busy
  let wagons = cv.cars[1:len(cv.cars)]
  addClass("gone", wagons)
  cv.cars = [cv.cars[0]]
  cv.gaps = [0]
  later 500
    remove wagons
  end
  add "pass" to named("flood-bot")
  view VH over 900ms
  roll(cv, total(R))
  drop "pass" from named("flood-bot")
  say "Node A draws the token" busy
  tokenWord(0, 300, 396)
  wait 400

  # Step 5: Each token makes 1 lap: activations out, logits back, the next token drawn.
  step 5
  view VS over 500ms
  fadeOut(cv.cars)
  retext(named("lapnote"), "THIS LAP, COUNTED LIVE")
  for n in range(1, len(DEMO.answer))
    let tr = train(R, 0, ["wagon"], "req", 40)
    S.lap = 0
    S.timing = true
    S.laps = 1.6 if n == 1 else 2.6
    say "Token " + str(n + 1) + ": 1 lap of the line" busy
    roll(tr, total(R))
    S.timing = false
    S.lap = lapOf(PL.cut).all
    showLap()
    tokenWord(n, 300, 396)
    if n < len(DEMO.answer) - 1
      remove tr.cars
    end
  end
  retext(named("lapnote"), "PER TOKEN, PREDICTED")
  S.laps = 1
  say "Answer complete"
  wait 600
end

scene prefill
  # Node B reads a long prompt, and its KV cache crosses back to node A as freight.
  shapeLoop("a", PL.cardA, LAYERS - PL.cardA)
  shapeLoop("b", PL.cardB, LAYERS - PL.cardB)
  let P = 14
  let CH = 4
  let R = [L(380, BOT, 120, BOT), A(120, BOT - 50, 50, PI / 2, PI / 2), L(70, BOT - 50, 70, TOP + 50), A(120, TOP + 50, 50, PI, PI / 2), L(120, TOP, 456, TOP), L(456, TOP, 584, TOP), L(584, TOP, JB, TOP)]
  R = R + loopPieces("b", PL.cardB, LAYERS - PL.cardB, PL.msB, PL.hostB)
  R = R + [L(JB, TOP, 900, TOP), A(900, TOP + 50, 50, -PI / 2, PI / 2), L(950, TOP + 50, 950, BOT - 50), A(900, BOT - 50, 50, 0, PI / 2), L(900, BOT, 600, BOT)]
  R[5].pace = 260
  # The frames of the camera, in a narrow column.
  let VQ = (30, 260, 436, 381)
  let VK = (12, 0, 436, 381)
  let VC2 = (553, 0, 436, 381)
  let VRiv = (297, 150, 436, 381)
  let VBb = (553, 180, 436, 381)
  let VD = (30, 200, 436, 381)
  let VA = (40, 160, 436, 381)

  # Step 0: A long prompt reaches a machine whose prefill_peer names another instance.
  step 0
  view VQ over 500ms
  let pt = train(R, sAtX(R, 0, 210), ["coach", "coach"], "coach", 40)
  emit at (215, 392) "a long prompt"
  wait 900

  # Step 1: Node A asks node B only while it delivers at least as fast as the local prefill.
  step 1
  view VK over 500ms
  setAttr(named("rate-peer"), "width", 218)
  setAttr(named("rate-here"), "width", 145)
  add "on" to named("rate-peer-t"), named("rate-here-t")
  wait 1000
  add "on" to named("ask")
  tone(1320, 60, "triangle", 0.08)
  say "Sending the prompt to node B" busy
  view VRiv over 800ms
  roll(pt, sAtX(R, 6, 700))

  # Step 2: Node B reads the prompt through its whole model, and its KV cache crosses back.
  step 2
  view VBb over 500ms
  add "busy" to named("st-b")
  say "Node B reads the prompt through its whole model" busy
  roll(pt, sAtX(R, len(R) - 1, 650))
  drop "busy" from named("st-b")
  fadeOut(pt.cars)
  let B2 = [L(880, BOT, 584, BOT), L(584, BOT, 456, BOT), L(456, BOT, 170, BOT)]
  B2[1].pace = 55
  let fr = train(B2, 230, ["flat", "flat", "flat", "flat"], "freight", 50)
  say "Loading the KV of every prompt token" busy
  for i in range(P)
    let j = i % CH
    let c = sprite("crate", (-99, -99))
    fr.cargo = fr.cargo + [{el: c, car: floor(i / CH) + 1, u: -7.5 + (j % 2) * 15, v: -7 + floor(j / 2) * 14}]
    put(fr, 230)
    tone(380 + i * 12, 30, "sine", 0.04)
    wait 90
  end
  emit at (760, 398) "heavy"
  view VRiv over 800ms
  say "The crates cross the river, slowly" busy
  roll(fr, sAtX(B2, 1, 560))
  noise(160, 0.06)
  view VD over 900ms
  roll(fr, total(B2))

  # Step 3: Node A checks the label against its cache shape and the prompt's tokens.
  step 3
  view VC2 over 500ms
  add "eval" to named("chk0")
  wait 600
  drop "eval" from named("chk0")
  add "ok" to named("chk0")
  add "eval" to named("chk1")
  wait 600
  drop "eval" from named("chk1")
  add "ok" to named("chk1")
  tone(1320, 60, "triangle", 0.08)
  view VD over 500ms
  say "Importing the cargo as a snapshot" busy
  let crates = [c.el for c in fr.cargo]
  fr.cargo = []
  carry([[c, slotAt(i)] for [i, c] in enumerate(crates)], 1100)
  retext(named("dock-n1"), "14 TOKENS")
  wait 400

  # Step 4: The prefix reuse keeps up to the last turn marker, or the last whole chunk when that keeps more.
  # The example prompt has no turn marker past token 12, so the 3 whole chunks are kept.
  step 4
  view VD over 500ms
  let whole = floor((P - 1) / CH) * CH
  let mark = shape("text", {class: "nd-cap nd-yardcap", x: 60, y: 394}, "NO TURN MARKER PAST TOKEN 12")
  say "Keeping 3 whole chunks" busy
  for b in range(floor(whole / CH))
    carry([[crates[b * CH + j], bayAt(b * CH + j)] for j in range(CH)], 600)
    add "full" to named("bay" + str(b))
  end
  addClass("idle", crates[whole:P])
  retext(named("dock-n1"), "2 LEFT")
  view VA over 700ms
  say "Reading the rest of the prompt here" busy
  add "busy" to named("st-a")
  let one = [L(200, TOP, JA, TOP)] + loopPieces("a", PL.cardA, LAYERS - PL.cardA, PL.msA, PL.hostA) + [L(JA, TOP, 380, TOP)]
  for g in one
    g.pace = g.pace * 2.5
  end
  let rd = train(one, 0, ["tok", "tok"], "coach", 24)
  roll(rd, total(one))
  fadeOut(rd.cars)
  view VD over 500ms
  let fresh = [sprite("crate", bayAt(whole + i)) for i in range(P - whole)]
  add "full" to named("bay3")
  say "Node A decodes" busy
  for n in range(len(DEMO.answer))
    let dc = train(one, 0, [], "shunt", 0)
    S.laps = 2
    roll(dc, total(one))
    remove dc.cars
    tokenWord(n, 300, 392)
  end
  S.laps = 1
  drop "busy" from named("st-a")
  say "Answer complete"
  wait 600
end
