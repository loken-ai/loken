# The routing decision of a node, as a rail yard seen from above.
# A request is a train that enters node A from the left.
# The signal box tests the rules in order, 1 lamp for each test.
# The points send the train to the local platform, or across the network to node B or node C.

# Samples of each route, every STEP units of the figure, as x and y in turn.
let STEP = 6
let R = {
  local: [-150, 360, -144, 360, -138, 360, -132, 360, -126, 360, -120, 360, -114, 360, -108, 360, -102, 360, -96, 360, -90, 360, -84, 360, -78, 360, -72, 360, -66, 360, -60, 360, -54, 360, -48, 360, -42, 360, -36, 360, -30, 360, -24, 360, -18, 360, -12, 360, -6, 360, 0, 360, 6, 360, 12, 360, 18, 360, 24, 360, 30, 360, 36, 360, 42, 360, 48, 360, 54, 360, 60, 360, 66, 360, 72, 360, 78, 360, 84, 360, 90, 360, 96, 360, 102, 360, 108, 360, 114, 360, 120, 360, 126, 360, 132, 360, 138, 360, 144, 360, 150, 360, 156, 360, 162, 360, 168, 360, 174, 360, 180, 360, 186, 360, 192, 360, 198, 360, 204, 360, 210, 360, 216, 360, 222, 360, 228, 360, 234, 360, 240, 360, 246, 360, 252, 360, 258, 360, 264, 360, 270, 360, 276, 360, 282, 360.1, 287.9, 361, 293.6, 363, 298.7, 366, 303.4, 369.8, 307.6, 374, 311.4, 378.7, 314.9, 383.6, 318, 388.7, 321, 393.9, 323.7, 399.3, 326.3, 404.7, 328.8, 410.1, 331.2, 415.6, 333.6, 421.1, 335.8, 426.7, 338.1, 432.2, 340.4, 437.8, 342.6, 443.4, 344.9, 448.9, 347.2, 454.4, 349.6, 459.9, 352.1, 465.4, 354.6, 470.8, 357.3, 476.2, 360.1, 481.5, 363.1, 486.7, 366.4, 491.8, 369.8, 496.7, 373.6, 501.3, 377.7, 505.7, 382.1, 509.7, 387, 513.3, 392.2, 516.1, 397.8, 518.3, 403.7, 519.5, 409.7, 520, 415.7, 520, 421.7, 520, 427.7, 520, 433.7, 520, 439.7, 520, 445.7, 520, 451.7, 520, 457.7, 520, 463.7, 520, 469.7, 520, 475.7, 520, 481.7, 520, 487.7, 520, 493.7, 520, 499.7, 520, 505.7, 520, 511.7, 520, 517.7, 520, 523.7, 520, 529.7, 520, 535.7, 520, 541.7, 520, 547.7, 520, 553.7, 520, 559.7, 520, 560, 520],
  b: [-150, 360, -144, 360, -138, 360, -132, 360, -126, 360, -120, 360, -114, 360, -108, 360, -102, 360, -96, 360, -90, 360, -84, 360, -78, 360, -72, 360, -66, 360, -60, 360, -54, 360, -48, 360, -42, 360, -36, 360, -30, 360, -24, 360, -18, 360, -12, 360, -6, 360, 0, 360, 6, 360, 12, 360, 18, 360, 24, 360, 30, 360, 36, 360, 42, 360, 48, 360, 54, 360, 60, 360, 66, 360, 72, 360, 78, 360, 84, 360, 90, 360, 96, 360, 102, 360, 108, 360, 114, 360, 120, 360, 126, 360, 132, 360, 138, 360, 144, 360, 150, 360, 156, 360, 162, 360, 168, 360, 174, 360, 180, 360, 186, 360, 192, 360, 198, 360, 204, 360, 210, 360, 216, 360, 222, 360, 228, 360, 234, 360, 240, 360, 246, 360, 252, 360, 258, 360, 264, 360, 270, 360, 276, 360, 282, 360, 288, 360, 294, 360, 300, 360, 306, 360, 312, 360, 318, 360, 324, 360, 330, 360, 336, 360, 342, 360, 348, 360, 354, 360, 360, 360, 366, 360, 372, 360, 378, 360, 384, 360, 390, 360, 396, 360, 402, 360, 408, 360, 414, 360, 420, 360, 426, 360, 432, 360, 437.9, 359.2, 443.7, 357.6, 449.2, 355.1, 454.3, 352, 459.1, 348.4, 463.5, 344.4, 467.7, 340, 471.6, 335.5, 475.3, 330.8, 478.9, 326, 482.4, 321.1, 485.8, 316.1, 489.1, 311.1, 492.4, 306.1, 495.7, 301.1, 499, 296.1, 502.4, 291.2, 505.9, 286.3, 509.5, 281.5, 513.3, 276.8, 517.2, 272.3, 521.3, 267.9, 525.7, 263.9, 530.4, 260.1, 535.5, 256.9, 540.8, 254.1, 546.4, 252, 552.2, 250.6, 558.2, 250, 564.2, 250, 570.2, 250, 576.2, 250, 582.2, 250, 588.2, 250, 594.2, 250, 600.2, 250, 606.2, 250, 612.2, 250, 618.2, 250, 624.2, 250, 630.2, 250, 636.2, 250, 642.2, 250, 648.2, 250, 654.2, 250, 660.2, 250, 666.2, 250, 672.2, 250, 678.2, 250, 684.2, 250, 690.2, 250, 696.2, 250, 702.2, 250, 708.2, 250, 714.2, 250, 720.2, 250, 726.2, 250, 732.2, 250, 738.2, 250, 744.2, 250, 750.2, 250, 756.2, 250, 762.2, 250, 768.2, 250, 774.2, 250, 780.2, 250, 786.2, 250, 792.2, 250, 798.2, 250, 804.2, 250, 810.2, 250, 816.2, 250, 822.2, 250, 828.2, 250, 834.2, 250, 840.2, 250, 846.2, 250, 852.2, 250, 858.2, 250, 864.2, 250, 870.2, 250, 876.2, 250, 882.2, 250, 888.2, 250, 894.2, 250, 900.2, 250, 906.2, 250, 912.2, 250, 918.2, 250, 924.2, 250, 930.2, 250, 936.2, 250, 942.2, 250, 948.2, 250, 954.2, 250, 960.2, 250, 966.2, 250, 972, 250],
  c: [-150, 360, -144, 360, -138, 360, -132, 360, -126, 360, -120, 360, -114, 360, -108, 360, -102, 360, -96, 360, -90, 360, -84, 360, -78, 360, -72, 360, -66, 360, -60, 360, -54, 360, -48, 360, -42, 360, -36, 360, -30, 360, -24, 360, -18, 360, -12, 360, -6, 360, 0, 360, 6, 360, 12, 360, 18, 360, 24, 360, 30, 360, 36, 360, 42, 360, 48, 360, 54, 360, 60, 360, 66, 360, 72, 360, 78, 360, 84, 360, 90, 360, 96, 360, 102, 360, 108, 360, 114, 360, 120, 360, 126, 360, 132, 360, 138, 360, 144, 360, 150, 360, 156, 360, 162, 360, 168, 360, 174, 360, 180, 360, 186, 360, 192, 360, 198, 360, 204, 360, 210, 360, 216, 360, 222, 360, 228, 360, 234, 360, 240, 360, 246, 360, 252, 360, 258, 360, 264, 360, 270, 360, 276, 360, 282, 360, 288, 360, 294, 360, 300, 360, 306, 360, 312, 360, 318, 360, 324, 360, 330, 360, 336, 360, 342, 360, 348, 360, 354, 360, 360, 360, 366, 360, 372, 360, 378, 360, 384, 360, 390, 360, 396, 360, 402, 360, 408, 360, 414, 360, 420, 360, 426, 360, 432, 360, 438, 360, 444, 360, 450, 360, 456, 360, 462, 360, 468, 360, 474, 360, 480, 360, 486, 360, 492, 360, 498, 360, 504, 360, 510, 360, 516, 360, 522, 360, 528, 360, 534, 360, 540, 360, 546, 360, 552, 360, 558, 360, 564, 360, 570, 360, 576, 360, 582, 360, 588, 360, 594, 360, 600, 360, 606, 360, 612, 360, 618, 360, 624, 360, 630, 360, 636, 360, 642, 360, 648, 360, 654, 360, 660, 360, 666, 360, 672, 360, 678, 360, 684, 360, 690, 360, 696, 360, 702, 360.1, 707.9, 360.9, 713.7, 362.6, 719.1, 365.2, 724, 368.6, 728.6, 372.4, 732.8, 376.7, 736.7, 381.3, 740.3, 386.1, 743.7, 391, 746.9, 396.1, 750, 401.3, 752.9, 406.5, 755.7, 411.8, 758.5, 417.1, 761.2, 422.5, 763.9, 427.8, 766.6, 433.2, 769.3, 438.6, 772, 443.9, 774.8, 449.2, 777.6, 454.5, 780.6, 459.7, 783.7, 464.9, 786.9, 469.9, 790.3, 474.8, 794, 479.6, 797.9, 484.1, 802.2, 488.3, 806.9, 492.1, 811.9, 495.3, 817.4, 497.8, 823.2, 499.4, 829.1, 500, 835.1, 500, 841.1, 500, 847.1, 500, 853.1, 500, 859.1, 500, 865.1, 500, 871.1, 500, 877.1, 500, 883.1, 500, 889.1, 500, 895.1, 500, 901.1, 500, 907.1, 500, 913.1, 500, 919.1, 500, 925.1, 500, 931.1, 500, 937.1, 500, 943.1, 500, 949.1, 500, 955.1, 500, 961.1, 500, 967.1, 500, 972, 500],
}
let SPEED = 250
# Where the locomotive starts, just beyond the left edge.
let ENTRY = 140
# Where the locomotive waits before the first points, its wagons behind it.
let HOLD = 390
# Where the locomotive stops at the end of each route.
let END = {local: 782, b: 1158, c: 1181}
# How far each car runs behind the locomotive.
let GAP = [0, 42, 81]
let CR = 15
let CIRC = 2 * 3.14159 * CR
let CLK = {here: (488, 454), b: (852, 176), c: (888, 444)}
let PI = 3.14159
let S = {dials: {}, here: none}

# The point of route `r` at `s` from its start, with the direction of the route there.
to spot(r, s)
  let pts = R[r]
  let n = len(pts) / 2 - 1
  let f = min(max(s / STEP, 0), n - 0.001)
  let i = floor(f)
  let t = f - i
  let x0 = pts[2 * i]
  let y0 = pts[2 * i + 1]
  let dx = pts[2 * i + 2] - x0
  let dy = pts[2 * i + 3] - y0
  let d = sqrt(dx * dx + dy * dy) or 1
  return [x0 + dx * t, y0 + dy * t, dx / d, dy / d]
end

# Sets every car of the train on its route, the locomotive at `s`.
to put(tr, s)
  tr.s = s
  for [i, car] in enumerate(tr.cars)
    let p = spot(tr.r, s - GAP[i])
    setAttr(car, "transform", "matrix(" + fixed(p[2], 3) + " " + fixed(p[3], 3) + " " + fixed(-p[3], 3) + " " + fixed(p[2], 3) + " " + fixed(p[0], 1) + " " + fixed(p[1], 1) + ")")
  end
end

# A train of 1 locomotive and 2 wagons in the livery `kind`, waiting beyond the left edge.
to train(kind, r)
  let cars = [sprite("loco", (0, 0)), sprite("wagon", (0, 0)), sprite("wagon", (0, 0))]
  add kind to cars
  let tr = {cars: cars, r: r, s: ENTRY}
  put(tr, ENTRY)
  return tr
end

# Runs the train to `s1`, starting and stopping smoothly.
to roll(tr, s1)
  let s0 = tr.s
  let ms = max(400, abs(s1 - s0) / SPEED * 1000)
  let t0 = clock()
  let u = 0
  while u < 1
    u = min(1, (clock() - t0) / ms)
    put(tr, s0 + (s1 - s0) * u * u * (3 - 2 * u))
    if u < 1
      wait 16
    end
  end
end

# The train fades at its platform: the request is served there.
to unload(tr)
  wait 300
  add "gone" to tr.cars
  wait 550
  remove tr.cars
end

# The centre of the locomotive.
to head(tr)
  let p = spot(tr.r, tr.s)
  return (p[0], p[1])
end

to lamp(n)
  return named("lamp" + str(n))
end

# Lamps 1 to n - 1 pass in turn, then lamp n tests.
to test(n)
  for i in range(1, n)
    add "eval" to lamp(i)
    wait 160
    drop "eval" from lamp(i)
    add "pass" to lamp(i)
  end
  add "eval" to lamp(n)
end

# Lamp n gives its verdict: `yes` or `stop`.
to verdict(n, cls)
  drop "eval" from lamp(n)
  add cls to lamp(n)
end

to lampsOff()
  for i in range(1, 7)
    for c in ["eval", "pass", "yes", "stop"]
      dropClass(c, lamp(i))
    end
  end
end

to signal(state)
  dropClass("go", named("signal"))
  dropClass("stop", named("signal"))
  addClass(state, named("signal"))
end

# The signal box lights route `r` and sets the points for it.
to setRoute(r)
  for k in ["lit-local", "lit-b", "lit-c", "lit-stop"]
    dropClass("on", named(k))
  end
  for k in ["s1-local", "s1-peers", "s2-b", "s2-c"]
    dropClass("set", named(k))
  end
  if r == "none"
    signal("stop")
    return none
  end
  if r == "stop"
    add "on" to named("lit-stop")
    signal("stop")
    return none
  end
  add "on" to named("lit-" + r)
  if r == "local"
    add "set" to named("s1-local")
  else
    add "set" to named("s1-peers")
    add "set" to named("s2-" + r)
  end
  tone(1320, 40, "triangle", 0.08)
  signal("go")
end

# Clears what the last request left on the panel and the points.
to tidy()
  lampsOff()
  setRoute("none")
end

# A clock of the yard: 1 arc for the round trip, 1 arc for the work, and a hand.
to dial(k)
  let c = CLK[k]
  let turn = "rotate(-90 " + str(c[0]) + " " + str(c[1]) + ")"
  let d = {c: c, rtt: 0, work: 0}
  d.rttArc = shape("circle", {class: "rt-arc rtt", cx: c[0], cy: c[1], r: CR, transform: turn, "stroke-dasharray": "0 999"})
  d.workArc = shape("circle", {class: "rt-arc work", cx: c[0], cy: c[1], r: CR, transform: turn, "stroke-dasharray": "0 999"})
  d.hand = shape("line", {class: "rt-hand", x1: c[0], y1: c[1], x2: c[0], y2: c[1] - 17})
  S.dials[k] = d
  return d
end

# Shows a share `rtt` of the dial for the round trip, then a share `work` for the node.
to show(d, rtt, work)
  d.rtt = rtt
  d.work = work
  setAttr(d.rttArc, "stroke-dasharray", fixed(rtt * CIRC, 2) + " " + fixed(CIRC, 2))
  setAttr(d.workArc, "stroke-dasharray", "0 " + fixed(rtt * CIRC, 2) + " " + fixed(work * CIRC, 2) + " " + fixed(CIRC, 2))
  setAttr(d.hand, "transform", "rotate(" + fixed((rtt + work) * 360, 1) + " " + str(d.c[0]) + " " + str(d.c[1]) + ")")
end

# Turns the dials of `goals` from where they stand to their goals, together.
to sweep(goals, ms)
  let start0 = [[g[0].rtt, g[0].work] for g in goals]
  let t0 = clock()
  let u = 0
  while u < 1
    u = min(1, (clock() - t0) / ms)
    let e = u * u * (3 - 2 * u)
    for [i, g] in enumerate(goals)
      show(g[0], start0[i][0] + (g[1] - start0[i][0]) * e, start0[i][1] + (g[2] - start0[i][1]) * e)
    end
    if u < 1
      wait 16
    end
  end
end

# A question that crosses to a peer and comes back: the round trip is measured on the way.
to probe(path)
  let p = dot(300, 360, 4, "rt-probe")
  move p along path speed 520
  move p along backwards(path) speed 520
  remove p
end

# The gauge: a wagon whose height is the best peer's predicted time rolls toward the bar.
# The local estimate stands 130 above the ground, and the bar 130 / 1.15 above it.
to gauge(load, passes)
  let w = sprite("gwagon", (398, 190))
  let crate = query(".dkt-sprite .rt-gcrate")[0]
  let planks = query(".dkt-sprite .rt-gcrate-planks")[0]
  setAttr(crate, "y", -16 - load)
  setAttr(crate, "height", load)
  setAttr(planks, "y", -16 - load)
  setAttr(planks, "height", load)
  wait 300
  if passes
    glide w to (548, 190) over 1600
    add "go" to named("glamp")
    emit at (508, 100) "fits under"
  else
    glide w to (447, 190) over 1100
    add "hit" to named("gbar")
    add "stop" to named("glamp")
    noise(90, 0.12)
    glide w to (440, 190) over 180
    emit at (420, 100) "too tall"
  end
  return w
end

to gaugeOff(w)
  remove w
  dropClass("go", named("glamp"))
  dropClass("stop", named("glamp"))
  dropClass("hit", named("gbar"))
end

# Every class the story gives to the drawing is taken back.
to reset()
  tidy()
  for k in ["st-b", "st-c", "st-here"]
    for c in ["down", "fail", "barred", "ping"]
      dropClass(c, named(k))
    end
  end
  dropClass("on", named("board409"))
  dropClass("hl", named("join"))
  dropClass("on", named("closed"))
  for i in range(10)
    dropClass("on", named("pen" + str(i)))
  end
  dropClass("go", named("glamp"))
  dropClass("stop", named("glamp"))
  dropClass("hit", named("gbar"))
end

# The stream of the answer, relayed from node B back to the client.
to stream(n)
  together for i in range(n)
    wait i * 160
    let t = dot(930, 250, 3.4, "rt-tok")
    move t along "M930,250 L560,250 C500,250 485,360 430,360 L-10,360" speed 460
    remove t
  end
end

# All the peers send a beat of the gossip.
to gossip()
  add "ping" to named("st-b"), named("st-c")
  wait 120
  drop "ping" from named("st-b"), named("st-c")
end

scene decide
  reset()

  # Step 0: join is empty, or the forwarded marker: the request stays here.
  step 0
  let t = train("req", "local")
  add "flag" to t.cars[0]
  add "hl" to named("join")
  together
    roll(t, HOLD)
  also
    wait 500
    test(1)
  end
  emit at (180, 318) "forwarded once"
  wait 500
  verdict(1, "yes")
  setRoute("local")
  row 0 "serving locally: already forwarded once"
  drop "hl" from named("join")
  roll(t, END.local)
  emit at (488, 380) "at most once"
  unload(t)
  tidy()

  # Step 1: work that yields goes to the nearest alive peer, or answers 409.
  step 1
  row 0 ""
  let b1 = train("batch", "b")
  together
    roll(b1, HOLD)
  also
    wait 400
    test(2)
  end
  say "Node B is the nearest alive peer" busy
  emit at (646, 222) "nearest"
  wait 400
  verdict(2, "yes")
  setRoute("b")
  row 0 "forwarding to B: work that yields, kept off the node holding a conversation"
  roll(b1, END.b)
  unload(b1)
  tidy()
  say "No peer alive, a conversation resident here" busy
  add "down" to named("st-b"), named("st-c")
  let conv = train("conv", "local")
  put(conv, END.local)
  let note = shape("text", {class: "rt-note", x: 487, y: 549, "text-anchor": "middle"}, "CONVERSATION, CACHE RESIDENT")
  wait 600
  let b2 = train("batch", "local")
  together
    roll(b2, HOLD)
  also
    wait 400
    test(2)
  end
  wait 300
  verdict(2, "stop")
  setRoute("stop")
  add "on" to named("board409")
  emit at (229, 372) "409"
  row 0 "409: this node is holding a conversation"
  wait 900
  add "gone" to b2.cars
  wait 700
  remove b2.cars
  add "gone" to conv.cars
  remove note
  wait 500
  remove conv.cars
  drop "down" from named("st-b"), named("st-c")
  drop "on" from named("board409")
  tidy()

  # Step 2: no local price for this model: the node serves it first and measures itself.
  step 2
  row 0 ""
  let q = shape("text", {class: "rt-q", x: CLK.here[0], y: CLK.here[1] + 7, "text-anchor": "middle"}, "?")
  emit at (488, 412) "no price yet"
  let t2 = train("req", "local")
  together
    roll(t2, HOLD)
  also
    wait 400
    test(3)
  end
  wait 300
  verdict(3, "yes")
  setRoute("local")
  row 0 "serving locally: no local price for this model yet"
  roll(t2, END.local)
  remove q
  let here = dial("here")
  sweep([[here, 0, 0.55]], 1200)
  emit at (488, 412) "measured"
  unload(t2)
  tidy()

  # Step 3: every candidate gets a predicted completion time, round trip included.
  step 3
  row 0 ""
  let t3 = train("req", "local")
  together
    roll(t3, HOLD)
  also
    wait 400
    test(4)
  end
  say "Asking each peer what it holds, timing the round trip" busy
  let db = dial("b")
  let dc = dial("c")
  together
    probe("M300,360 L430,360 C485,360 500,250 560,250 L852,250")
  also
    probe("M300,360 L700,360 C760,360 770,500 830,500 L888,500")
  end
  say "Predicting the completion on every node" busy
  sweep([[here, 0, 0.55], [db, 0.08, 0.42], [dc, 0.16, 0.5]], 1600)
  let ring = shape("circle", {class: "rt-best", cx: CLK.b[0], cy: CLK.b[1], r: 27})
  emit at (736, 150) "lowest"
  row 0 "lowest estimate: node B"
  wait 900

  # Step 4: the best peer must beat the local estimate by min_speedup.
  step 4
  row 0 ""
  verdict(4, "pass")
  add "eval" to lamp(5)
  say "Node B is only a little faster" busy
  let w = gauge(102, false)
  wait 500
  verdict(5, "stop")
  setRoute("local")
  row 0 "serving locally: peer B is below the 1.15x a hand-over has to earn"
  roll(t3, END.local)
  unload(t3)
  gaugeOff(w)
  remove ring
  tidy()

  # Step 5: a peer that clears the margin gets the request whole, and the stream comes back.
  step 5
  row 0 ""
  let t5 = train("req", "b")
  together
    roll(t5, HOLD)
  also
    wait 400
    test(4)
    say "Node B has less work now" busy
    sweep([[db, 0.08, 0.3]], 900)
    verdict(4, "pass")
    add "eval" to lamp(5)
  end
  let w5 = gauge(74, true)
  wait 300
  verdict(5, "yes")
  setRoute("b")
  row 0 "forwarding to B: faster there"
  roll(t5, END.b)
  say "Relaying the stream of node B, unchanged" busy
  stream(6)
  unload(t5)
  gaugeOff(w5)
  tidy()

  # Step 6: the peer fails before it answers: back here, and the peer sits out.
  step 6
  row 0 ""
  let t6 = train("req", "b")
  together
    roll(t6, HOLD)
  also
    wait 400
    test(5)
    add "go" to named("glamp")
    wait 300
    verdict(5, "yes")
  end
  setRoute("b")
  row 0 "forwarding to B: faster there"
  roll(t6, 980)
  add "fail" to named("st-b")
  add "eval" to lamp(6)
  emit at (736, 150) "no answer"
  wait 900
  verdict(6, "stop")
  dropClass("go", named("glamp"))
  say "Backing out of node B" busy
  setRoute("none")
  roll(t6, HOLD)
  t6.r = "local"
  setRoute("local")
  row 0 "hand-over to B failed: serving here instead"
  roll(t6, END.local)
  unload(t6)
  drop "fail" from named("st-b")
  add "barred" to named("st-b")
  add "on" to named("closed")
  add "on" to [named("pen" + str(i)) for i in range(10)]
  remove db.rttArc, db.workArc, db.hand
  row 0 "B is not a candidate for 10 gossip intervals"
  for i in range(10)
    rowNote(0, str(10 - i) + " left")
    gossip()
    drop "on" from named("pen" + str(9 - i))
    wait 330
  end
  rowNote(0, "")
  drop "on" from named("closed")
  drop "barred" from named("st-b")
  emit at (736, 150) "candidate again"
  tidy()
  wait 900
end
