# The scenes of the requests page: an image spliced into a prompt, and a conversation continued.
# A column is 1 token.
# A row of a grid is 1 layer of the KV cache.

# The classes the stories give, so that leaving a scene clears them.
for n in ["s-other", "s-empty", "s-rest", "s-drop", "s-read", "s-hot", "s-same", "s-x", "s-on", "s-match", "s-miss", "s-gone", "s-new", "s-diff", "s-cut", "s-form", "s-snap", "s-run", "s-sent", "s-fill", "s-pop", "s-grid", "s-merge", "s-open", "s-pos", "s-call", "s-count", "s-flow1", "s-flow2"]
  light "turnset" n off
  light "visionset" n off
end

# The elements of a set that match `sel`.
to q(sel)
  return query(sel)
end

# ---- A conversation continued ---------------------------------------------------------------

# The left edge of the column of token `c`.
to colx(c)
  return 120 + c * 27
end

# The 4 rows of token `c` in the KV cache on the card.
to kvcol(c)
  return q(".rq-turn .kv.c" + str(c))
end

# The row of token `c` at layer `l`.
to kvcell(c, l)
  return q(".rq-turn .kv.c" + str(c) + ".l" + str(l))
end

# The token cell `c` of the prompt, and its copy in the snapshot.
to tk(c)
  return q(".rq-turn .tk.c" + str(c))
end
to sn(c)
  return q(".rq-turn .sn.c" + str(c))
end

# The block file `b` on disk, and the link that chains it to the block before.
to blk(b)
  return q(".rq-turn .blk.b" + str(b))
end
to link(b)
  return q(".rq-turn .link.k" + str(b))
end

# The middle of the block file `b`.
to blkmid(b)
  return (colx(4 * b) + 52, 498)
end

# The counter of the tokens read through the layers, drawn at the foot of the figure.
to counter()
  shape("rect", {class: "rd-b", x: 112, y: 551, width: 396, height: 34, rx: 9})
  shape("text", {class: "rd-k", x: 126, y: 573}, "READ THROUGH THE LAYERS")
  return shape("text", {class: "rd-v", x: 496, y: 576, "text-anchor": "end"}, "0 of 32")
end

# Tokens `c0` to `c1` are read: they enter 1 by 1, then each layer computes their rows.
to readTail(c0, c1, cnt)
  let n = 0
  for c in range(c0, c1)
    addClass("s-pop", tk(c))
    n += 1
    retext(cnt, str(n) + " of 32")
    row 2 str(n) + " of 32"
    wait 70ms
  end
  for l in range(4)
    for c in range(c0, c1)
      addClass("s-read", kvcell(c, l))
      dropClass("s-drop", kvcell(c, l))
      wait 18ms
    end
    wait 120ms
  end
  dropClass("s-pop", q(".rq-turn .tk"))
end

scene turn
  # A conversation continued.
  # The resident KV after turn 1 holds the user turn and the answer: 26 tokens.
  row 0 "none yet"
  row 1 "none yet"
  row 2 "26 of 26, turn 1"

  # Step 0: After an answer, the resident KV is copied aside as a snapshot, under its tokens.
  # The snapshot is held where the layers live.
  step 0
  view (0, 258, 560, 228)
  wait 300
  light "turnset" "s-snap" on
  for c in range(26)
    addClass("s-hot", kvcol(c))
    addClass("s-on", sn(c))
    wait 50ms
    dropClass("s-hot", kvcol(c))
  end
  emit at (200, 409) "copied aside"
  wait 900

  # Step 1: With kv_disk_dir set, a thread writes the full blocks of the cache to disk, off the request path.
  # Each block is named by a hash of the block before it and of its own tokens.
  # The last block, not yet full, stays off disk.
  step 1
  view (0, 384, 560, 222)
  wait 300
  for b in range(6)
    let p = sprite("pkt", (colx(4 * b) + 52, 435))
    glideAll([[p, blkmid(b)]], 360)
    remove p
    addClass("s-on", blk(b))
    if b > 0
      addClass("s-on", link(b))
    end
    wait 160
  end
  addClass("s-on", q(".rq-turn .blk.part"))
  light "turnset" "s-form" on
  wait 1400

  # Step 2: Another conversation takes the card.
  # The resident KV now holds its rows, and the snapshot keeps ours.
  step 2
  view (0, 194, 530, 218)
  wait 300
  light "turnset" "s-other" on
  for c in range(26)
    if c < 21
      addClass("s-other", kvcol(c))
    else
      addClass("s-empty", kvcol(c))
    end
    wait 30ms
  end
  row 2 "0, another conversation runs"
  wait 1200

  # Step 3: The next turn repeats the conversation and adds a new turn.
  # The prompt is compared with the snapshot token by token, and with the chain on disk block by block.
  step 3
  view (440, 342, 560, 228)
  light "turnset" "s-new" on
  wait 300
  row 2 "not yet"
  wait 900
  for c in range(23)
    addClass("s-same", tk(c))
    addClass("s-same", sn(c))
    row 0 "snapshot " + str(c + 1)
    wait 60ms
  end
  addClass("s-x", tk(23))
  addClass("s-x", sn(23))
  light "turnset" "s-diff" on
  wait 700
  for b in range(5)
    addClass("s-match", blk(b))
    if b > 0
      addClass("s-match", link(b))
    end
    wait 260
  end
  addClass("s-miss", blk(5))
  light "turnset" "s-match" on
  row 0 "snapshot 23, disk 20"
  wait 1400

  # Step 4: Each candidate keeps its rows up to the last turn marker of the shared part, or up to the
  #   last whole prefill chunk when that keeps more.
  # The snapshot keeps more than the resident KV and as much as the disk, so it becomes the resident.
  step 4
  view (420, 204, 560, 228)
  wait 300
  for c in [22, 21, 20, 19, 18]
    dropClass("s-same", tk(c))
    dropClass("s-same", sn(c))
    wait 110ms
  end
  light "turnset" "s-cut" on
  row 1 "18 rows, up to the marker"
  wait 700
  light "turnset" "s-other" off
  for c in range(26)
    dropClass("s-other", kvcol(c))
    dropClass("s-empty", kvcol(c))
    addClass("s-rest", kvcol(c))
    wait 30ms
  end
  wait 500
  for c in range(18, 26)
    dropClass("s-rest", kvcol(c))
    addClass("s-drop", kvcol(c))
    wait 60ms
  end
  wait 1200

  # Step 5: The rows after the cut are dropped.
  # Only the tokens after the cut go through the layers: here the answer and the new turn, 14 of the 32 tokens.
  step 5
  view (420, 200, 560, 218)
  wait 300
  let cnt = counter()
  readTail(18, 32, cnt)
  wait 1200

  # Step 6: After a restart, memory holds no snapshot.
  # The chain on disk still matches 5 blocks, which come back as a snapshot, and the same cut leaves the same tail to read.
  step 6
  view (0, 370, 560, 228)
  wait 300
  light "turnset" "s-gone" on
  light "turnset" "s-cut" off
  light "turnset" "s-diff" off
  light "turnset" "s-match" off
  dropClass("s-x", tk(23))
  dropClass("s-miss", blk(5))
  for c in range(26)
    dropClass("s-same", sn(c))
    dropClass("s-x", sn(c))
    addClass("s-gone", sn(c))
  end
  for c in range(32)
    dropClass("s-rest", kvcol(c))
    dropClass("s-read", kvcol(c))
    dropClass("s-drop", kvcol(c))
    addClass("s-empty", kvcol(c))
  end
  dropClass("s-same", q(".rq-turn .tk"))
  dropClass("s-match", q(".rq-turn .blk"))
  dropClass("s-match", q(".rq-turn .link"))
  retext(cnt, "0 of 32")
  row 0 "disk 20"
  row 1 "not yet"
  row 2 "not yet"
  wait 1100
  for b in range(5)
    addClass("s-match", blk(b))
    if b > 0
      addClass("s-match", link(b))
    end
    for c in range(4 * b, 4 * b + 4)
      addClass("s-same", tk(c))
    end
    wait 200
  end
  addClass("s-miss", blk(5))
  light "turnset" "s-match" on
  for b in range(5)
    let p = sprite("pkt", blkmid(b))
    addClass("up", p)
    glideAll([[p, (colx(4 * b) + 52, 315)]], 380)
    remove p
    for c in range(4 * b, 4 * b + 4)
      dropClass("s-empty", kvcol(c))
      addClass("s-rest", kvcol(c))
    end
  end
  wait 500
  for c in [19, 18]
    dropClass("s-same", tk(c))
    dropClass("s-rest", kvcol(c))
    addClass("s-drop", kvcol(c))
    wait 120ms
  end
  light "turnset" "s-cut" on
  row 1 "18 rows, up to the marker"
  wait 700
  for c in range(18, 32)
    dropClass("s-empty", kvcol(c))
  end
  view (420, 200, 560, 218)
  readTail(18, 32, cnt)
  wait 1200
end

# ---- An image in a chat ---------------------------------------------------------------------

# The middle of the patch of row `r` and column `c` of the image.
to patchmid(r, c)
  return (38 + c * 18 + 9, 222 + r * 18 + 9)
end

# The middle of the merged embedding `i`, row by row.
to embmid(i)
  return (416 + (i % 4) * 35 + 15, 232 + floor(i / 4) * 29 + 12)
end

# The middle of the slot `i` of the run in the prompt.
to slotmid(i)
  return (384 + i * 40 + 18, 519)
end

scene vision
  # An image in a chat.
  # The way of an image through a model whose vision tower splices into the text.
  row 0 "7 tokens"

  # Step 0: A chat request with an image arrives.
  # The template puts 1 image placeholder in the prompt, and the tokenizer turns the text into ids.
  step 0
  view (0, 360, 560, 190)
  wait 300
  for ch in q(".rq-vision .chip")
    addClass("s-pop", ch)
    wait 110ms
  end
  light "visionset" "s-call" on
  light "visionset" "s-count" on
  let cnt = shape("text", {class: "cnt-v", x: 801, y: 291, "text-anchor": "middle"}, "1 placeholder, 1 token")
  wait 600
  dropClass("s-pop", q(".rq-vision .chip"))
  wait 900

  # Step 1: The image is cut into a grid of patches, and the vision tower turns them into embeddings.
  # It merges each square of 2 by 2 patches into 1 embedding.
  step 1
  view (0, 194, 560, 228)
  wait 300
  light "visionset" "s-call" off
  light "visionset" "s-grid" on
  light "visionset" "s-flow1" on
  wait 700
  let tiles = []
  for r in range(6)
    for c in range(8)
      let cell = q(".rq-vision .pt.r" + str(r) + ".q" + str(c))
      let t = sprite("ptile", patchmid(r, c))
      addClass(data(cell[0], "c"), t)
      tiles += [t]
      addClass("s-hot", cell)
    end
  end
  addClass("s-run", q(".rq-vision .tb"))
  together for [i, t] in enumerate(tiles)
    wait i * 22
    glideAll([[t, (244, 317)]], 520)
    remove t
  end
  dropClass("s-hot", q(".rq-vision .pt"))
  light "visionset" "s-merge" on
  addClass("s-run", q(".rq-vision .merger"))
  say "Merging each square of 2 by 2 patches" busy
  wait 700
  for i in range(12)
    let e = sprite("emb", (374, 233))
    glideAll([[e, embmid(i)]], 260)
    remove e
    addClass("s-on", q(".rq-vision .me.m" + str(i)))
  end
  dropClass("s-run", q(".rq-vision .tb"))
  dropClass("s-run", q(".rq-vision .merger"))
  light "visionset" "s-flow1" off
  say stepText()
  wait 900

  # Step 2: At prefill, the placeholder grows into a run of tokens, 1 per merged patch of the image.
  # The embeddings take the place of that run, row after row.
  step 2
  view (408, 360, 560, 228)
  wait 300
  light "visionset" "s-open" on
  light "visionset" "s-flow2" on
  for i in range(12)
    addClass("s-on", q(".rq-vision .slot.s" + str(i)))
    retext(cnt, "1 placeholder, " + str(i + 1) + " token" + ("" if i == 0 else "s"))
    row 0 str(7 + i) + " tokens"
    wait 85ms
  end
  emit at (660, 334) "1 per merged patch"
  wait 600
  for r in range(3)
    let flying = []
    for c in range(4)
      let i = r * 4 + c
      let e = sprite("emb", embmid(i))
      addClass("s-sent", q(".rq-vision .me.m" + str(i)))
      flying += [[e, slotmid(i)]]
    end
    glideAll(flying, 620)
    for [i, m] in enumerate(flying)
      remove m[0]
      addClass("s-fill", q(".rq-vision .slot.s" + str(r * 4 + i)))
    end
    addClass("s-on", q(".rq-vision .vrow.r" + str(r)))
    wait 200
  end
  light "visionset" "s-flow2" off
  wait 900

  # Step 3: Each image token takes the row and the column of its merged patch as its position, counted on from where the image starts.
  # The text after the image resumes past it.
  step 3
  view (339, 400, 481, 198)
  wait 300
  light "visionset" "s-pos" on
  wait 1400
  view (500, 400, 481, 198) over 1500
  wait 1800

  # Step 4: The prompt is read through the layers, the image rows with the text rows.
  step 4
  view (250, 380, 480, 198)
  wait 300
  for l in range(4)
    addClass("s-hot", q(".rq-vision .lyr.l" + str(l)))
    for n in range(18)
      addClass("s-fill", q(".rq-vision .vkv.v" + str(n) + ".l" + str(l)))
      wait 16ms
    end
    wait 140ms
    dropClass("s-hot", q(".rq-vision .lyr.l" + str(l)))
  end
  row 0 "18 tokens, read"
  wait 1200
end
