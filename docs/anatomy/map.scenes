# The way of a request over the map: the prompt's tokens climb the layers together, then each token
#   of the answer climbs the stack, reads and extends the KV cache of each run on its card, is drawn by the
#   sampler and streams out of the mouth.

let DEMO = {prompt: "What is the capital of France?", tokens: ["What", " is", " the", " capital", " of", " France", "?"], answer: ["The", " capital", " is", " Paris", "."]}

# The runs of the example plan, from layer 0 up: where a dot enters and leaves each, and the top of its KV cache.
let RUNS = [{kind: "dc", name: "CUDA card", from: 462, to: 296, top: 350}, {kind: "dr", name: "ROCm card", from: 294, to: 178, top: 200}]
let HEAD = (500, 166)
let MOUTH = (512, 142)
let BASE = (500, 462)
# The speed of a token that climbs a run.
let CLIMB = 360

# The figure as drawn: the sampler still, the KV cache of each run empty.
drop "roll" from named("sampler")
dropClass("on", query(".mp-cell"))
dropClass("read", query(".mp-cell"))
dropClass("new", query(".mp-cell"))

to unlight()
  dropClass("lit", query("[data-source=\"backends\"], [data-source=\"stack\"]"))
end

# Tells which element the token is near.
to report(label, x)
  if label then
    addClass("lit", query("[data-source=\"backends\"], [data-source=\"stack\"]"))
    say "Computing on " + label busy
    light "backends" "flex" on
  else
    unlight()
    say stepText()
    light "backends" "flex" off
  end
end

to setBase(text)
  restText(text)
end

to rebase(text)
  restText(text)
  say text
end

scene overview
  # The way of a request.
  # The KV cache of each run, drawn in the figure: 1 cell for every prompt token and every answer
  #   token fed back.
  let cells = [query(".mp-cell-" + run.kind) for run in RUNS]
  # A flash around the KV cache of `run`, gone after a moment.
  to burst(run)
    let b = shape("rect", {class: "mp-burst", x: 336, y: run.top - 4, width: 132, height: 66, rx: 9})
    later 650ms
      remove b
    end
  end
  # A flash on the KV cache of run `r`: it reads every lit cell and lights cell `i`.
  to flash(r, i)
    let run = RUNS[r]
    let lit = [c for c in cells[r] if contains(c, "on")]
    add "read" to lit
    burst(run)
    add "new" to cells[r][i]
    light "kv" "glow"
    wait 320
    drop "read" from lit
    drop "new" from cells[r][i]
    add "on" to cells[r][i]
  end

  # Step 0: Received: the request arrives on an API surface.
  # Its template is applied and its text turned into tokens.
  step 0
  view (90, 40, 420, 273)
  focus("requests")
  light "requests" "speak"
  shape("text", {class: "mp-cap", x: 100, y: 108}, "PROMPT")
  shape("rect", {class: "mp-tape", x: 100, y: 116, width: 346, height: 32, rx: 5})
  let whole = shape("text", {class: "mp-text", x: 114, y: 137}, DEMO.prompt)
  shape("text", {class: "mp-cap", x: 566, y: 108}, "ANSWER")
  shape("rect", {class: "mp-tape", x: 566, y: 116, width: 334, height: 32, rx: 5})
  wait 1.2s
  remove whole
  let tx = 108
  let chips = []
  for w in DEMO.tokens
    let back = shape("rect", {class: "mp-chip", x: tx, y: 121, width: 10, height: 22, rx: 4})
    let t = shape("text", {class: "mp-text", x: tx + 5, y: 137}, trim(w))
    let tw = textWidth(t)
    setAttr(back, "width", tw + 10)
    chips += [back]
    tx += tw + 15
    wait 90
  end
  say str(len(DEMO.tokens)) + " tokens"
  wait 900

  # Step 1: Prefilled: the prompt's tokens climb the layers together, a long prompt in chunks.
  # Each layer keeps their keys and values in its own KV cache, on the card of its run.
  step 1
  view (300, 100, 330, 215)
  focus("loop")
  let band = []
  for c in chips
    add "read" to c
    band += [dot(attr(c, "x") + attr(c, "width") / 2, 152, 3.6, "small")]
  end
  glideAll([[d, MOUTH] for d in band], 700)
  setBase("Prompt tokens to layer 0")
  together for d in band
    move d along named("feed") speed 520
  end
  to lineUp(y)
    return [(d, (500 + (i - (len(band) - 1) / 2) * 9, y)) for [i, d] in enumerate(band)]
  end
  glideAll(lineUp(BASE[1]), 400)
  for d in band
    drop "small" from d
    add "busy" to d
  end
  let ref = shape("circle", {class: "apath", r: 0, "data-r": 0, "data-big": 0})
  light "loop" "breathe"
  setBase("Reading the prompt together")
  for [r, run] in enumerate(RUNS)
    view (330, run.top - 30, 300, 195)
    glideAll(lineUp(run.to), 900, follow(ref, 500, "report"))
    unlight()
    focus("kv")
    rebase("KV kept on the " + run.name)
    for i in range(len(band))
      add "on" to cells[r][i]
    end
    burst(run)
    light "kv" "glow"
    wait 900
    focus("loop")
  end
  remove ref
  glideAll([[d, HEAD] for d in band], 400)
  let main = band[-1]
  remove band[0:-1]
  rebase("The last token gives the first logits")
  wait 800

  let said = ""
  let wx = 578
  let words = []
  for n in range(len(DEMO.answer))
    if n > 0
      # Step 2: Forwarded: each decode step climbs the layer stack, run after run.
      # Each layer reads the KV cache of the earlier tokens and adds the step's own token to it,
      #   on the same card.
      step 2
      focus("stack")
      light "loop" "breathe"
      # 2 other requests take the same step in the batch.
      let others = [dot(500 + dx, BASE[1], 2.8, "other") for dx in [-12, 12]]
      setBase("Climbing, in 1 batch with 2 others")
      for [r, run] in enumerate(RUNS)
        view (330, run.top - 30, 300, 195)
        together
          move main along "M500," + str(run.from) + " L500," + str(run.to) speed CLIMB tracked by report
        also
          glideAll([[d, (attr(d, "cx"), run.to)] for d in others], (run.from - run.to) * 1000 / CLIMB)
        end
        unlight()
        focus("kv")
        say "KV read and extended, " + run.name
        flash(r, len(DEMO.tokens) + n - 1)
        focus("stack")
      end
      remove others
      glide main to HEAD over 220
    end
    # Step 3: Sampled: the output head gives the logits and the sampler draws the next token.
    # When a request arrives while others run, a model that can batch runs their steps as 1 batch.
    # 3 lone arrivals in a row take it back to 1 at a time.
    step 3
    view (360, 100, 330, 215)
    focus("loop")
    move main along named("draw") speed 200
    add "roll" to named("sampler")
    compute main for 450 if n == 0 else 300 say "Drawing the next token"
    drop "roll" from named("sampler")
    # Step 4: Streamed: the answer streams out as it is decoded, a token at a time.
    # Each drawn token is also the input of the next decode step, at layer 0.
    step 4
    view (500, 60, 410, 266)
    focus("requests")
    move main along named("speak") speed 200
    light "requests" "speak"
    add "old" to words
    let w = shape("text", {class: "mp-word", x: wx, y: 137}, trim(DEMO.answer[n]))
    words += [w]
    wx += textWidth(w) + (0 if n + 1 < len(DEMO.answer) and DEMO.answer[n + 1] == "." else 9)
    said += DEMO.answer[n]
    row 0 said
    rowNote(0, "token " + str(n + 1) + " of " + str(len(DEMO.answer)))
    if n + 1 < len(DEMO.answer)
      say "Back to layer 0 as input"
      move main along named("feed") speed 640
    else
      wait 400
    end
  end
  remove main
  add "old" to words
  say "Answer complete"
  focus()
end
