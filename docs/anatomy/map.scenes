# The way of a request, as the map tells it: the prompt is read in one pass, then every token of the
# answer climbs the stack, reads the KV cache, is drawn and streamed.

to mid(b)
  return (attr(b, "x") + 4.5, attr(b, "y") + 4.5)
end

scene overview
  # The way of a request.
  # The KV cache in the head: one slot for every prompt token and every answer token fed back.
  let slots = [shape("rect", {class: "box kvb", x: 473 + (i % 5) * 11, y: 58 + floor(i / 5) * 12, width: 9, height: 9, rx: 1.5}) for i in range(len(DEMO.tokens) + len(DEMO.answer) - 1)]
  # Step 0: Received: the request arrives on an API surface.
  # Its template is applied and its text turned into tokens.
  step 0
  light "requests" "speak"
  let tx = 526
  let chips = []
  for w in DEMO.tokens
    let t = label(tx, 162, trim(w), class="ptok")
    tx += textWidth(t) + 5
    chips += [t]
  end
  wait 1.1s
  # Step 1: Prefilled: the prompt's tokens climb the layers together, a long prompt in chunks.
  # Each token leaves its key and value in the KV cache.
  step 1
  setAttr(main, "opacity", 0)
  let band = []
  for t in chips
    let b = box(t)
    band += [dot(b.x + b.width / 2, 154, 2.4, "small")]
  end
  remove chips
  to lineUp(y)
    return [(d, (500 + (i - (len(band) - 1) / 2) * 7, y)) for [i, d] in enumerate(band)]
  end
  glideAll(lineUp(374), 800)
  setBase("Reading the " + str(len(band)) + " prompt tokens in one pass")
  for d in band
    drop "small" from d
    setAttr(d, "r", 3.2)
    add "busy" to d
  end
  let ref = shape("circle", {class: "apath", r: 0, "data-r": 0, "data-big": 0})
  light "loop" "breathe"
  glideAll(lineUp(172), 1600, follow(ref, 500))
  remove ref
  unlight()
  rebase("Keeping the KV of every prompt token")
  let kvs = []
  for d in band
    let spot = pos(d)
    remove d
    kvs += [dotAt(spot, 2, "kv")]
  end
  glideAll([[d, mid(slots[i])] for [i, d] in enumerate(kvs)], 800)
  remove kvs
  add "on" to slots[0:len(band)]
  light "kv" "glow"
  setAttr(main, "cx", 500)
  setAttr(main, "cy", 172)
  setAttr(main, "opacity", 1)
  say "The last prompt token gives the first answer token"
  wait 800
  to litSlots()
    return [b for b in slots if contains(b, "on")]
  end
  for n in range(len(DEMO.answer))
    light "loop" "breathe"
    if n == 0
      # The first token's logits come out of the prefill: nothing climbs again.
      rebase("Taking the logits of the last prompt token")
      ride(ROUTES.kv, 240)
    else
      # Step 2: Forwarded: each decode step climbs the layer stack, run after run.
      step 2
      ride(ROUTES.down, 520)
      # 2 other requests take the same step in the batch.
      let others = [dot(500 + dx, 374, 2.6, "other") for dx in [-11, 11]]
      setBase("Climbing the layers, in one batch with 2 other requests")
      together
        ride(ROUTES.up, 520)
      also
        glideAll([[d, (500 + (11 if i else -11), 172)] for [i, d] in enumerate(others)], 390)
      end
      remove others
      # Step 3: Remembered: the step reads the KV cache and adds its own token to it.
      step 3
      ride(ROUTES.kv, 420)
      add "read" to litSlots()
      light "kv" "glow"
      say "Reading the KV of every earlier token"
      wait 380
      drop "read" from litSlots()
      add "on" to slots[len(DEMO.tokens) + n - 1]
      say "Adding this token's KV"
      wait 260
    end
    # Step 4: Sampled: the output head gives the logits and the sampler draws the next token.
    # Once requests have overlapped several times in a row, their steps run as one batch.
    step 4
    ride(ROUTES.sample, 520 if n else 260)
    flash("Computing the draw of the next token", 200 if n else 450)
    # Step 5: Streamed: the answer streams out as it is decoded.
    step 5
    ride(ROUTES.out, 520 if n else 260)
    emitWord(DEMO.answer[n], n + 1)
    wait 120 if n else 400
  end
  wait 700
  remove main
  say "Answer complete"
  unlightAll()
  complete()
end
