# The scenes of the placement board.
# A column is a device standing in its slot, as tall as the memory it offers.
# The cards stand from left to right by compute rate, the host is the wide bank on the right.
# A layer is 2 blocks side by side: its weights, tinted by its device, and its KV cache.
# Blocks move by a CSS transform, so a jump to a step lands at once.
# A word of the class `tmp` lasts until the story removes the words of that class.
# Every step frames its useful part with `view`, which acts only in a narrow column.

let BASE = 560
let KVW = 13

# The pattern fills, read from their carriers in the figure, which hold the ids the page gives them.
let F = {pcb: style(named("f-pcb"), "fill"), host: style(named("f-host"), "fill"), trace: style(named("f-trace"), "fill"), gold: style(named("f-gold"), "fill"), hatch: style(named("f-hatch"), "fill"), wood: style(named("f-wood"), "fill")}

# The slot rail of the figure shows in every scene but the ladder.
drop "gone" from query(".rail"), query(".rail-slot")

# Sets the thing `e` at `x`, `y`, turned by `r` degrees when given.
to put(e, x, y, r)
  let t = "translate(" + fixed(x, 1) + "px," + fixed(y, 1) + "px)"
  if r
    t = t + " rotate(" + str(r) + "deg)"
  end
  style(e, "transform", t)
end

# Starts the moves, each `[thing, x, y]` or `[thing, x, y, degrees]`, `ms` long, and goes on at once.
to launch(moves, ms)
  for m in moves
    style(m[0], "transitionDuration", str(ms) + "ms")
    style(m[0], "transitionDelay", "0ms")
    put(m[0], m[1], m[2], m[3] if len(m) > 3 else none)
  end
end

# Starts the moves and waits for them.
to slide(moves, ms)
  launch(moves, ms)
  wait ms
end

# Shows the hidden things `es` one after the other, `gap` apart, and waits for the last.
# Reading a box first sets the style they start from, so they fade even while the scene is held.
to reveal(es, gap)
  box(es[0])
  for [j, e] in enumerate(es)
    style(e, "transitionDelay", "0ms," + str(j * gap) + "ms,0ms")
    drop "gone" from e
  end
  wait len(es) * gap + 500
end

# Pours the hidden layers `rs` from where they wait into the `places`, 1 after the other, `gap` apart.
to pour(rs, places, ms, gap)
  box(rs[0].w)
  for [j, r] in enumerate(rs)
    launch(spot(r, places[j][0], places[j][1]), ms)
    for e in [r.w, r.k]
      style(e, "transitionDelay", str(j * gap) + "ms")
      drop "gone" from e
    end
  end
  wait ms + len(rs) * gap
end

# The moves that shift the placed things `items`, each `[thing, x, y]`, by `dx`.
to shifted(items, dx)
  return [[m[0], m[1] + dx, m[2]] + m[3:] for m in items]
end

# A text of the classes `cls` at `x`, `y`.
to tx(x, y, t, cls)
  return shape("text", {class: cls, x: x, y: y}, t)
end

# A text that moves, set at `x`, `y`, turned by `r` degrees when given.
to word(x, y, t, cls, r)
  let e = shape("text", {class: cls + " mv", x: 0, y: 0}, t)
  style(e, "transitionDuration", "0ms,.5s")
  put(e, x, y, r)
  return e
end

# A block of the classes `cls`, `w` wide and `h` high, its top left corner at `x`, `y`.
to block(x, y, w, h, cls)
  let e = shape("rect", {class: "blk " + cls, x: 0, y: 0, width: w, height: h, rx: 2})
  style(e, "transitionDuration", "0ms,.5s,.5s")
  put(e, x, y)
  return e
end

# A runtime reserve: a hatched block, `w` wide and `h` high.
to resv(x, y, w, h, cls)
  let e = block(x, y, w, h, "res " + (cls or ""))
  style(e, "fill", F.hatch)
  return e
end

# The top of the block in the slot `n` from the bottom of a column whose slots are `u` high.
to slotY(n, u)
  return BASE - (n + 1) * u + 1.5
end

# A device column in the rail: `kind` is "a", "b" or "h", `h` the memory it offers.
# The name and the line under it sit below the rail.
to column(x, w, h, kind, name, sub)
  let tp = BASE - h
  shape("rect", {class: "col-shd", x: x + 4, y: tp - 4, width: w, height: h + 12, rx: 9})
  let body = shape("rect", {class: "col-" + kind, x: x, y: tp - 8, width: w, height: h + 14, rx: 9})
  if kind == "h"
    style(body, "fill", F.host)
    shape("rect", {class: "well-h", x: x + 7, y: tp, width: w - 14, height: h, rx: 4})
  else
    style(body, "fill", F.pcb)
    style(shape("rect", {class: "col-tex", x: x, y: tp - 8, width: w, height: h + 14, rx: 9}), "fill", F.trace)
    style(shape("rect", {class: "fing", x: x + 10, y: BASE + 4, width: w - 20, height: 9}), "fill", F.gold)
    shape("rect", {class: "well", x: x + 7, y: tp, width: w - 14, height: h, rx: 4})
    for cy in range(floor(tp) + 10, BASE - 14, 26)
      shape("rect", {class: "chip", x: x + 1.5, y: cy, width: 4, height: 12, rx: 1})
      shape("rect", {class: "chip", x: x + w - 5.5, y: cy, width: 4, height: 12, rx: 1})
    end
  end
  shape("rect", {class: "stripe-" + kind, x: x + 7, y: tp - 5, width: w - 14, height: 3, rx: 1.5})
  tx(x + w / 2, BASE + 36, name, "nm mid")
  let s = tx(x + w / 2, BASE + 55, sub, "s mid")
  return {x: x, w: w, h: h, tp: tp, ix: x + 7, iw: w - 14, kind: kind, sub: s, mid: x + w / 2}
end

# The mark of the free memory of the column `c`, on its right.
to freeMark(c)
  let x = c.x + c.w + 6
  let d = "M" + str(x) + "," + str(c.tp) + " h5 V" + str(BASE) + " h-5"
  return [shape("path", {class: "brace", d: d}), word(x + 20, (c.tp + BASE) / 2, "free memory", "s mid", -90)]
end

# A link between 2 devices, from `x0` to `x1`, at the height `y`.
to link(x0, x1, y)
  let ps = [shape("rect", {class: "link", x: x0, y: y, width: x1 - x0, height: 8, rx: 3})]
  style(ps[0], "fill", F.gold)
  if x1 - x0 > 50
    ps += [tx((x0 + x1) / 2, y - 7, "LINK", "link-t mid")]
  end
  return ps
end

# A layer: its weights, `w` wide with its KV cache, `u` high, set at `x`, `y`.
to layer(i, kind, w, u, x, y)
  let a = block(x, y, w - KVW - 3, u - 3, kind)
  let k = block(x + w - KVW, y, KVW, u - 3, "kv")
  if contains(a, "gone")
    add "gone" to k
  end
  return {i: i, w: a, k: k, kind: kind, wd: w, u: u, x: x, y: y}
end

# The moves that set the layer `r` at `x`, `y`.
to spot(r, x, y)
  r.x = x
  r.y = y
  return [[r.w, x, y], [r.k, x + r.wd - KVW, y]]
end

# Tints the weights of the layer `r` with the device `kind`.
to paint(r, kind)
  r.kind = kind
  setAttr(r.w, "class", "blk " + kind)
end

# The output head: a block 2 slots high with its name, set at `x`, `y`.
to headAt(x, y, w, u)
  let b = block(x, y, w, 2 * u - 3, "hd")
  let t = word(x + w / 2, y + u + 4, "output head", "on-head mid")
  return {b: b, t: t, w: w, u: u}
end

# The moves that set the head `hd` at `x`, `y`.
to headTo(hd, x, y)
  return [[hd.b, x, y], [hd.t, x + hd.w / 2, y + hd.u + 4]]
end

# The token of a step: a hot dot.
to token(x, y)
  return shape("circle", {class: "pulse ly-tok", cx: x, cy: y, r: 7})
end

# The token `p` climbs the layers `rs` at `x`, `ms` for each layer, and lights each.
to climb(p, rs, x, ms)
  for r in rs
    glideAll([[p, (x, r.y + r.u / 2 - 1.5)]], ms)
    add "lit" to r.w, r.k
  end
end

# The logits: bars standing on `y` from `x`, 1 bar for each vocabulary entry, a few drawn.
# Their name sits on the `side` given: "left", "right" or "top".
to logits(x, y, side)
  let hs = [10, 22, 6, 30, 12, 8, 16]
  let bars = []
  for [j, h] in enumerate(hs)
    bars += [shape("rect", {class: "blk hd gone tmp", x: x + j * 9, y: y - h, width: 6, height: h, rx: 1})]
  end
  if side == "left"
    bars += [tx(x - 6, y - 6, "logits", "sb end halo gone tmp")]
  elif side == "right"
    bars += [tx(x + 66, y - 6, "logits", "sb halo gone tmp")]
  else
    bars += [tx(x + 30, y - 38, "logits", "sb mid halo gone tmp")]
  end
  reveal(bars, 40)
  return bars
end

# A bar meter at `x`, `y`, `w` wide, filled to `f`, with its `name` above it.
to meter(x, y, w, f, cls, name)
  return [tx(x, y - 6, name, "s tmp"), shape("rect", {class: "meter tmp", x: x, y: y, width: w, height: 8, rx: 3}), shape("rect", {class: cls + " tmp", x: x, y: y, width: w * f, height: 8, rx: 3})]
end

# Gives the layers `rs` the class `cls`, or takes it back.
to shade(rs, cls, yes)
  for r in rs
    style(r.w, "transitionDelay", "0ms")
    style(r.k, "transitionDelay", "0ms")
    if yes
      add cls to r.w, r.k
    else
      drop cls from r.w, r.k
    end
  end
end

# ---------------------------------------------------------------------------------------------
scene one
  # A model on one card.
  let U = 12
  let RW = 96
  let DX = 270
  let A = column(410, 110, 21 * U, "a", "card A", "1st by compute rate")
  let B = column(590, 110, 33 * U, "b", "card B", "2nd by compute rate")
  # Step 0: The cards are ordered by a compute rate, timed or estimated, a pinned card first, and each one offers its free memory.
  step 0
  view (396, 140, 350, 495)
  let marks = freeMark(A) + freeMark(B)
  marks += [shape("path", {class: "brace", d: "M410,96 H700 M692,91 L700,96 L692,101"}), tx(555, 86, "ranked by compute rate, a pinned card first", "s mid")]
  add "gone" to marks
  reveal(marks, 250)
  wait 600

  # Step 1: The demand adds the layers, the output head, the KV cache at the planned context and a runtime reserve.
  step 1
  view (258, 170, 330, 470)
  let items = []
  let L = []
  for i in range(24)
    let r = layer(i, "g gone", RW, U, DX, slotY(i, U))
    L += [r]
    items += [[r.w, DX, r.y], [r.k, DX + RW - KVW, r.y]]
  end
  let hy = slotY(25, U)
  let head = block(DX, hy, RW, 2 * U - 3, "hd gone")
  let ht = word(DX + RW / 2, hy + 15, "output head", "on-head mid gone")
  let ry = slotY(28, U)
  let res = resv(DX, ry, RW, 3 * U - 3, "gone")
  let rt = word(DX + RW / 2, ry + 21, "reserve", "sb mid halo gone")
  let lt = word(DX + 44, slotY(12, U), "24 layers", "sb mid halo gone", -90)
  let kt = word(DX + RW, slotY(12, U), "KV cache", "sb mid halo gone", -90)
  let dt = word(DX + RW / 2, ry - 9, "DEMAND", "capb mid gone")
  items += [[head, DX, hy], [ht, DX + RW / 2, hy + 15], [res, DX, ry], [rt, DX + RW / 2, ry + 21], [lt, DX + 44, slotY(12, U), -90], [kt, DX + RW, slotY(12, U), -90], [dt, DX + RW / 2, ry - 9]]
  let order = [dt]
  for r in L
    order += [r.w, r.k]
  end
  reveal(order + [lt, kt, head, ht, res, rt], 22)
  wait 700

  # Step 2: The first card in that order that holds the whole demand receives every layer, the head and the caches. A pinned card is the only one tried.
  step 2
  view (258, 150, 330, 490)
  slide(shifted(items, A.ix - DX), 1000)
  let ov = shape("rect", {class: "over", x: A.ix - 3, y: ry - 1, width: RW + 6, height: A.tp - ry + 1, rx: 3})
  let no = [sprite("cross", (A.x + A.w + 16, A.tp + 2)), tx(A.mid, ry - 28, "too small", "bad-t mid halo")]
  noise(160, 0.05)
  wait 1300
  remove ov, no[1]
  retext(A.sub, "too small: skipped")
  view (400, 140, 345, 495)
  slide(shifted(items, B.ix - DX), 1100)
  let fit = shape("rect", {class: "fit", x: B.ix - 3, y: ry - 1, width: RW + 6, height: BASE - ry + 1, rx: 3})
  sprite("check", (B.x + B.w + 2, ry))
  for r in L
    paint(r, "b")
  end
  retext(B.sub, "every layer, head, caches")
  wait 900
  remove fit

  # Step 3: A token climbs every layer on that card.
  step 3
  view (520, 150, 230, 490)
  let x = B.ix + (RW - KVW - 3) / 2
  let p = token(x, BASE + 2)
  climb(p, L, x, 70)
  glideAll([[p, (x, hy + 10)]], 200)

  # Step 4: The output head on the same card gives the logits.
  step 4
  view (470, 96, 280, 530)
  add "pulse-on" to head
  compute p for 700ms say "The output head on card B giving the logits"
  logits(B.ix + 26, B.tp - 14, "left")
  remove p
  wait 1200
  drop "pulse-on" from head
end

# ---------------------------------------------------------------------------------------------
scene runs
  # Layers spread over 2 cards.
  let U = 16
  let RW = 110
  let A = column(300, 124, 17.5 * U, "a", "card A", "1st by compute rate")
  let B = column(540, 124, 13 * U, "b", "card B", "2nd by compute rate")
  link(424, 540, 520)
  # Step 0: No card holds the whole model, and the cards together do.
  step 0
  view (280, 96, 420, 525)
  let gy = BASE - 27 * U
  let g = block(A.ix, gy, RW, 27 * U, "g")
  setAttr(g, "class", "ghost mv")
  let gt = word(A.ix + RW / 2, gy - 8, "the whole model", "sb mid halo")
  let ov = shape("rect", {class: "over", x: A.ix - 3, y: gy, width: RW + 6, height: A.tp - gy, rx: 3})
  let zap = sprite("cross", (A.x + A.w + 14, A.tp + 2))
  noise(140, 0.04)
  wait 1200
  remove ov, zap
  slide([[g, B.ix, gy], [gt, B.ix + RW / 2, gy - 8]], 800)
  ov = shape("rect", {class: "over", x: B.ix - 3, y: gy, width: RW + 6, height: B.tp - gy, rx: 3})
  zap = sprite("cross", (B.x - 14, B.tp + 2))
  noise(140, 0.04)
  wait 1200
  remove ov, zap, g, gt
  let both = [shape("path", {class: "brace-ok", d: "M" + str(A.ix) + ",158 V146 H" + str(B.ix + RW) + " V158"}), tx(482, 134, "together: room for every layer", "ok-t mid halo")]
  wait 900

  # Step 1: The cards are filled in rank order until every layer has a card.
  step 1
  view (280, 200, 420, 440)
  remove both
  resv(A.ix, A.tp, RW, U - 3)
  tx(A.mid, A.tp + 12, "reserve", "sb mid halo")
  resv(B.ix, B.tp, RW, U - 3)
  tx(B.mid, B.tp + 12, "reserve", "sb mid halo")
  let hold = shape("rect", {class: "ghost", x: B.ix, y: slotY(11, U), width: RW, height: 2 * U - 3, rx: 2})
  let holdt = tx(B.mid, slotY(11, U) + 20, "for the head", "s mid halo")
  let L = [layer(i, ("a" if i < 16 else "b") + " gone", RW, U, A.ix if i < 16 else B.ix, 150) for i in range(24)]
  pour(L, [(A.ix, slotY(i, U)) if i < 16 else (B.ix, slotY(i - 16, U)) for i in range(24)], 520, 45)
  retext(A.sub, "16 layers")
  retext(B.sub, "8 layers")
  wait 500

  # Step 2: When the model keeps a KV cache and every card has a compute rate, the same layers are then shared out by that rate, within what each card holds.
  step 2
  view (280, 180, 420, 460)
  meter(A.ix, A.tp - 26, RW, 0.58, "meter-a", "compute rate")
  meter(B.ix, B.tp - 26, RW, 0.42, "meter-b", "compute rate")
  wait 700
  let mv = []
  for r in L[16:]
    mv += spot(r, B.ix, slotY(r.i - 14, U))
  end
  mv += spot(L[14], B.ix, slotY(0, U)) + spot(L[15], B.ix, slotY(1, U))
  slide(mv, 1200)
  paint(L[14], "b")
  paint(L[15], "b")
  retext(A.sub, "layers 0 to 13")
  retext(B.sub, "layers 14 to 23")
  tx(482, 206, "16 and 8 become 14 and 10", "sb mid halo tmp")
  wait 1000

  # Step 3: The output head stays on the card of the last layer, and each layer keeps its KV cache on its own card.
  step 3
  view (280, 180, 420, 460)
  remove hold, holdt, query(".tmp")
  let head = headAt(B.ix, 200, RW, U)
  slide(headTo(head, B.ix, slotY(11, U)), 700)
  tx(482, 206, "each layer's KV cache on its own card", "sb mid halo tmp")
  for r in L
    add "pulse-on" to r.k
  end
  wait 1800
  for r in L
    drop "pulse-on" from r.k
  end

  # Step 4: A token climbs the run of card A, crosses once to card B and climbs the run of card B. The cards take turns.
  step 4
  view (280, 250, 420, 390)
  remove query(".tmp")
  let xa = A.ix + (RW - KVW - 3) / 2
  let xb = B.ix + (RW - KVW - 3) / 2
  shade(L[14:], "dim", true)
  add "dim" to head.b
  let p = token(xa, BASE + 2)
  climb(p, L[:14], xa, 80)
  shade(L[:14], "dim", true)
  shade(L[14:], "dim", false)
  drop "dim" from head.b
  move p via (A.x + A.w - 4, L[13].y + 6), (A.x + A.w, 524), (B.x, 524) speed 520
  let hop = shape("circle", {class: "hop", cx: 482, cy: 524, r: 7})
  tx(482, 548, "1 hop", "sb mid halo tmp")
  move p via (xb, BASE + 2) speed 520
  climb(p, L[14:], xb, 80)
  glideAll([[p, (xb, slotY(11, U) + 12)]], 200)
  add "pulse-on" to head.b
  compute p for 600ms say "The output head on card B giving the logits"
  logits(B.ix + 40, B.tp - 14, "left")
  remove p
  wait 900
  drop "pulse-on" from head.b

  # Step 5: When the plan uses exactly 2 cards with no layer or expert on the host, the card that reads memory at least 1.1 times faster holds the head and as many layers as it can, keeping its reserve and a sixteenth of the card. The slower card takes the first layers. This plan is kept when it cuts the token time by more than 3%.
  step 5
  view (280, 64, 430, 525)
  remove hop, query(".tmp")
  shade(L, "dim", false)
  shade(L, "lit", false)
  shape("rect", {class: "card-bg", x: 266, y: 66, width: 468, height: 96, rx: 8})
  tx(280, 88, "card A reads 2.5 times faster than card B", "sb")
  shape("rect", {class: "meter", x: 280, y: 96, width: 300, height: 9, rx: 3})
  shape("rect", {class: "meter-ok", x: 280, y: 96, width: 250, height: 9, rx: 3})
  shape("line", {class: "thr", x1: 390, y1: 91, x2: 390, y2: 110})
  tx(396, 124, "at least 1.1", "s")
  tx(280, 150, "token time: 96.6% of the plan above, under 97%", "sb")
  sprite("check", (712, 98))
  sprite("check", (712, 144))
  wait 1500
  let mv2 = []
  for r in L[:11]
    mv2 += spot(r, B.ix, slotY(r.i, U))
  end
  for r in L[11:]
    mv2 += spot(r, A.ix, slotY(r.i - 11, U))
  end
  mv2 += headTo(head, A.ix, slotY(14, U))
  slide(mv2, 1500)
  view (280, 150, 430, 475)
  for r in L
    paint(r, "b" if r.i < 11 else "a")
  end
  retext(A.sub, "layers 11 to 23, head")
  retext(B.sub, "runs first: 0 to 10")
  let k0 = A.tp + U
  let k1 = k0 + A.h / 16
  shape("rect", {class: "dip", x: A.ix - 2, y: k0, width: RW + 4, height: k1 - k0, rx: 2})
  shape("path", {class: "brace", d: "M" + str(A.x + A.w + 4) + "," + str(k0) + " h7 V" + str(k1) + " h-7"})
  tx(A.x + A.w + 16, k0 + 6, "a sixteenth", "sb")
  tx(A.x + A.w + 16, k0 + 23, "kept free", "s")
  wait 500
  p = token(xb, BASE + 2)
  climb(p, L[:11], xb, 55)
  move p via (B.x + 4, L[10].y + 6), (B.x, 524), (A.x + A.w, 524), (xa, BASE + 2) speed 620
  climb(p, L[11:], xa, 55)
  glideAll([[p, (xa, slotY(14, U) + 12)]], 160)
  add "pulse-on" to head.b
  compute p for 600ms say "The output head on card A giving the logits"
  remove p
  logits(A.ix + 18, A.tp - 34, "right")
  wait 1000
  drop "pulse-on" from head.b
end

# ---------------------------------------------------------------------------------------------
scene tail
  # A dense model larger than the cards.
  let U = 15
  let RW = 92
  let A = column(264, 106, 12.5 * U, "a", "card A", "rank 1")
  let B = column(388, 106, 10.5 * U, "b", "card B", "rank 2")
  let H = column(526, 210, 18 * U, "h", "host", "host memory")
  let zig = "M533," + str(H.tp - 2)
  for j in range(8)
    zig = zig + " l12,-8 l12,8"
  end
  shape("path", {class: "cut", d: zig + " V" + str(H.tp + 6) + " H533 Z"})
  tx(H.mid, H.tp + 26, "HOST MEMORY", "cap mid")
  link(370, 388, 520)
  link(494, 526, 520)
  resv(A.ix, A.tp, RW, 1.5 * U - 3)
  resv(B.ix, B.tp, RW, 1.5 * U - 3)
  # Step 0: A dense model is larger than the cards, even with blocks taken out of each card's runtime reserve.
  step 0
  view (258, 170, 430, 470)
  let head = headAt(B.ix, slotY(8, U), RW, U)
  add "gone" to head.b, head.t
  let L = [layer(i, ("a" if i < 12 else ("b" if i < 19 else "g")) + " gone", RW, U, A.ix, 150) for i in range(24)]
  let wait11 = (A.ix, 300)
  pour(L, [(A.ix, slotY(i, U)) if i < 11 else (wait11 if i == 11 else ((B.ix, slotY(i - 12, U)) if i < 19 else (404 + (i - 19) * 5, 214 + (i - 19) * U))) for i in range(24)], 520, 40)
  reveal([head.b, head.t], 60)
  let dip = shape("rect", {class: "dip gone fade", x: A.ix - 3, y: A.tp - 2, width: RW + 6, height: 1.5 * U + 2, rx: 3})
  let dipt = [tx(266, A.tp - 72, "1 block out of the reserve,", "s halo gone fade"), tx(266, A.tp - 55, "here on A: the cards share it", "s halo gone fade"), shape("path", {class: "brace gone fade", d: "M" + str(A.mid) + "," + str(A.tp - 50) + " V" + str(A.tp - 6)})]
  reveal([dip] + dipt, 100)
  slide(spot(L[11], A.ix, slotY(11, U)), 700)
  retext(A.sub, "layers 0 to 11")
  retext(B.sub, "12 to 18, head")
  tx(450, 200, "no room left on the cards", "bad-t mid halo tmp")
  wait 900

  # Step 1: The last layers stay on the host, read in place from the file's mapping where their format allows, so the page cache holds them and the kernel may reclaim them.
  step 1
  view (480, 250, 270, 390)
  remove query(".tmp")
  let hx = H.ix + 8
  let mv = []
  for r in L[19:]
    paint(r, "h")
    mv += spot(r, hx, slotY(r.i - 19, U))
  end
  slide(mv, 1200)
  retext(H.sub, "layers 19 to 23")
  tx(H.mid, H.tp + 58, "read in place from", "s mid")
  tx(H.mid, H.tp + 76, "the file mapping", "s mid")
  wait 1000
  tx(H.mid, H.tp + 104, "held in the page cache", "s mid")
  tx(H.mid, H.tp + 122, "kernel may reclaim it", "s mid")
  wait 900

  # Step 2: Those layers keep their KV cache in host memory.
  step 2
  view (480, 250, 270, 390)
  for r in L[19:]
    add "pulse-on" to r.k
  end
  tx(H.mid + 30, H.tp + 152, "their KV cache,", "sb mid")
  tx(H.mid + 30, H.tp + 170, "in host memory", "sb mid")
  wait 1800
  for r in L[19:]
    drop "pulse-on" from r.k
  end

  # Step 3: A token climbs the runs of the cards, then crosses to the host and climbs the host run.
  step 3
  view (258, 300, 250, 340)
  let xa = A.ix + (RW - KVW - 3) / 2
  let xb = B.ix + (RW - KVW - 3) / 2
  let xh = hx + (RW - KVW - 3) / 2
  let p = token(xa, BASE + 2)
  climb(p, L[:12], xa, 80)
  move p via (A.x + A.w - 3, L[11].y + 6), (A.x + A.w, 524), (B.x, 524), (xb, BASE + 2) speed 520
  climb(p, L[12:19], xb, 80)
  view (388, 300, 350, 340)
  move p via (B.x + B.w - 3, L[18].y + 6), (B.x + B.w, 524), (H.x, 524), (xh, BASE + 2) speed 360
  climb(p, L[19:], xh, 220)

  # Step 4: The vector crosses back to the last card for the output head.
  step 4
  view (380, 290, 360, 350)
  let y0 = L[23].y - 4
  let y1 = slotY(8, U) - 2
  let d = "M" + str(xh) + "," + str(y0) + " C" + str(xh) + "," + str(y0 - 90) + " " + str(xb + 40) + "," + str(y1 - 90) + " " + str(xb) + "," + str(y1)
  shape("path", {class: "way-back", d: d})
  shape("path", {class: "arrowhead", d: "M" + str(xb - 7) + "," + str(y1 - 12) + " L" + str(xb) + "," + str(y1) + " L" + str(xb + 8) + "," + str(y1 - 10) + " Z"})
  move p along d speed 260
  add "pulse-on" to head.b
  compute p for 700ms say "The output head on card B giving the logits"
  remove p
  logits(B.ix + 14, B.tp - 14, "top")
  wait 1200
  drop "pulse-on" from head.b
end

# ---------------------------------------------------------------------------------------------
# The experts of a mixture: 1 brick for each layer.
let EW = 40

# Where the brick of the layer `i` waits before the experts are placed.
to tray(i)
  return (324 + (i % 8) * 44, 66 + floor(i / 8) * 13)
end

scene spill
  # A mixture whose experts leave the cards.
  let U = 13
  let RW = 56
  let A = column(262, 146, 13 * U, "a", "card A", "layers 0 to 11")
  let B = column(418, 146, 15 * U, "b", "card B", "layers 12 to 23")
  let H = column(576, 162, 150, "h", "host", "host memory")
  tx(H.mid, H.tp + 20, "HOST MEMORY", "cap mid")
  resv(A.ix, A.tp, A.iw, U - 3)
  resv(B.ix, B.tp, B.iw, U - 3)
  # Step 0: Every layer's attention, router, shared expert and KV cache go to a card.
  step 0
  view (258, 330, 310, 310)
  let L = []
  for i in range(24)
    let c = A if i < 12 else B
    let r = layer(i, c.kind + " gone", RW, U, c.ix, 300)
    r.c = c
    r.n = i % 12
    L += [r]
  end
  pour(L, [(r.c.ix, slotY(r.n, U)) for r in L], 480, 30)
  let head = headAt(B.ix, slotY(13, U), B.iw, U)
  tx(288, 360, "attention, router,", "s")
  tx(288, 376, "shared expert, KV", "s")
  let E = [block(tray(i)[0], tray(i)[1], EW, U - 3, "ex gone") for i in range(24)]
  tx(500, 118, "routed experts, 1 brick for each layer", "s mid")
  reveal(E, 20)
  wait 300

  # Step 1: When the routed experts do not fit on the cards beside them, 1 of 3 ways takes them. The file's expert format and the room on the cards choose.
  step 1
  view (285, 56, 430, 260)
  let ends = [359, 500, 641]
  let T = []
  let P = []
  let Lp = []
  let titles = [["back on the cards"], ["file mapping"], ["experts in", "host memory"]]
  let conds = [["format served,", "all experts fit,", "split if faster"], ["format served,", "no room for all,", "slots on each card"], ["format not served"]]
  for [k, x] in enumerate(ends)
    let d = "M500,128 C500,172 " + str(x) + ",172 " + str(x) + ",222"
    shape("path", {class: "track", d: d})
    T += [shape("path", {class: "track-on gone fade", d: d})]
    P += [shape("rect", {class: "plaque", x: x - 70, y: 222, width: 140, height: 84, rx: 7})]
    Lp += [shape("circle", {class: "lamp", cx: x + 58, cy: 222, r: 6})]
    let y = 242
    for t in titles[k]
      tx(x - 64, y, t, "sb")
      y += 17
    end
    for s in conds[k]
      tx(x - 64, y, s, "s")
      y += 17
    end
  end
  shape("circle", {class: "lamp on", cx: 500, cy: 128, r: 6})
  wait 1500

  # The way `k` lights.
  to choose(k)
    for j in range(3)
      if j == k
        drop "gone" from T[j]
        add "on" to P[j], Lp[j]
      else
        add "gone" to T[j]
        drop "on" from P[j], Lp[j]
      end
    end
  end

  # The place on the host shelf of the brick `n`.
  to shelf(n)
    return (H.ix + 8 + (n % 3) * 46, BASE - 16 - (floor(n / 3) + 1) * 13)
  end

  # The bricks go back to the tray.
  to back(ms)
    slide([[e, tray(j)[0], tray(j)[1]] for [j, e] in enumerate(E)], ms)
  end

  # Step 2: When the card cache serves the file's expert format, the routed experts of every layer stay in the file's mapping, and each card keeps a cache of expert slots for its layers.
  step 2
  view (418, 216, 330, 400)
  choose(1)
  retext(H.sub, "file mapping")
  slide([[e, shelf(j)[0], shelf(j)[1]] for [j, e] in enumerate(E)], 1300)
  let S = []
  for r in L
    for q in range(3)
      S += [block(r.c.ix + RW + 4 + q * 16, slotY(r.n, U), 13, U - 3, "slot gone")]
    end
  end
  reveal(S, 5)
  for [j, s] in enumerate(S)
    if j % 7 == 0 or j % 11 == 1
      add "full" to s
    end
  end
  let ties = [shape("path", {class: "tie", d: "M" + str(H.ix) + ",470 C" + str(H.ix - 30) + ",470 " + str(B.x + B.w + 10) + ",470 " + str(B.x + B.w - 6) + ",470"})]
  ties += [tx(583, 326, "the cards cache hot experts in slots", "sb mid halo")]
  wait 2000

  # Step 3: When the cards also have room for every expert, with at least 2 cards, a read rate for each card and a measured link, each layer takes its experts back instead, split across the cards by id range where that is predicted faster.
  step 3
  view (256, 216, 320, 400)
  remove S, ties
  retext(H.sub, "host memory")
  choose(0)
  back(700)
  slide([[e, L[j].c.ix + RW + 4, slotY(L[j].n, U)] for [j, e] in enumerate(E)], 1300)
  let G = []
  for j in [3, 8, 14, 21]
    let r = L[j]
    let o = B if r.c == A else A
    setAttr(E[j], "width", 24)
    G += [block(r.c.ix + RW + 30, slotY(r.n, U), 16, U - 3, "ex")]
    wait 120
    slide([[G[-1], o.ix + RW + 48, slotY(r.n, U)]], 600)
    G += [shape("path", {class: "tie", d: "M" + str(r.c.ix + RW + 28) + "," + str(slotY(r.n, U) + 5) + " L" + str(o.ix + RW + 48) + "," + str(slotY(r.n, U) + 5)})]
  end
  G += [tx(416, 326, "a layer split by id range over 2 cards", "sb mid halo")]
  wait 2000

  # Step 4: When the card cache cannot serve the file's expert format, only the experts of the last layers stay in host memory. Their layers keep attention and KV cache on the cards.
  step 4
  view (418, 216, 330, 400)
  remove G
  for e in E
    setAttr(e, "width", EW)
  end
  choose(2)
  back(700)
  retext(H.sub, "experts in host memory")
  let mv = []
  for [j, e] in enumerate(E)
    if j < 19
      mv += [[e, L[j].c.ix + RW + 4, slotY(L[j].n, U)]]
    else
      mv += [[e, shelf(j - 19)[0], shelf(j - 19)[1]]]
    end
  end
  slide(mv, 1300)
  for j in range(19, 24)
    let s = shelf(j - 19)
    shape("path", {class: "tie", d: "M" + str(s[0]) + "," + str(s[1] + 5) + " C" + str(s[0] - 30) + "," + str(s[1] + 5) + " " + str(B.x + B.w + 20) + "," + str(slotY(L[j].n, U) + 5) + " " + str(B.ix + RW + 2) + "," + str(slotY(L[j].n, U) + 5)})
  end
  tx(583, 326, "their attention and KV stay on card B", "sb mid halo")
  wait 2000
end

# ---------------------------------------------------------------------------------------------
scene split
  # Every layer split across a group of cards, here 2.
  let U = 12
  let LW = 170
  let WA = LW * 0.6
  let WB = LW - WA
  let A = column(290, 190, 26 * U, "a", "card A", "first card")
  let B = column(520, 190, 26 * U, "b", "card B", "second card")
  let bus = shape("rect", {class: "bus", x: 486, y: A.tp + 4, width: 28, height: BASE - A.tp - 8, rx: 4})
  word(500, (A.tp + BASE) / 2, "LINK", "link-t mid", -90)
  let ra = A.ix + A.iw - 6
  # Step 0: The model does not fit 1 card, every layer of its file can be split, and the split is predicted faster for 1 token and for a prompt chunk, or the layers would otherwise reach the host.
  step 0
  view (288, 56, 425, 400)
  shape("rect", {class: "card-bg tmp", x: 280, y: 62, width: 440, height: 172, rx: 8})
  tx(294, 84, "PREDICTED TIME, SHORTER WINS", "cap tmp")
  tx(294, 118, "1 token", "sb tmp")
  shape("rect", {class: "meter-g tmp", x: 420, y: 102, width: 150, height: 9, rx: 3})
  tx(576, 111, "layer by layer", "s tmp")
  shape("rect", {class: "meter-ok tmp", x: 420, y: 117, width: 106, height: 9, rx: 3})
  tx(532, 126, "split", "sb tmp")
  tx(294, 158, "1 prompt chunk", "sb tmp")
  shape("rect", {class: "meter-g tmp", x: 420, y: 142, width: 156, height: 9, rx: 3})
  tx(582, 151, "layer by layer", "s tmp")
  shape("rect", {class: "meter-ok tmp", x: 420, y: 157, width: 128, height: 9, rx: 3})
  tx(554, 166, "split", "sb tmp")
  tx(294, 198, "memory", "sb tmp")
  shape("rect", {class: "meter-a tmp", x: 420, y: 184, width: 110, height: 9, rx: 3})
  tx(536, 193, "card A", "s tmp")
  shape("rect", {class: "over tmp", x: 420, y: 199, width: 180, height: 9, rx: 3})
  tx(606, 208, "the model", "s tmp")
  tx(500, 226, "or the layers would otherwise reach the host", "s mid tmp")
  wait 800
  sprite("check", (702, 114))
  sprite("check", (702, 154))
  sprite("cross", (702, 196))
  wait 900

  # Step 1: Every layer is split across the cards of the group, here 2, each card's share following its read rate.
  step 1
  view (288, 200, 425, 440)
  remove query(".tmp"), query(".dkt-sprite")
  let L = []
  for i in range(24)
    let y = slotY(i, U)
    L += [{i: i, y: y, u: U, a: block(ra - WA, y, WA, U - 3, "a gone"), b: block(B.ix + 6, y, WB, U - 3, "b gone")}]
  end
  let order = []
  for r in L
    order += [r.a, r.b]
  end
  reveal(order, 15)
  retext(A.sub, "larger share: reads faster")
  retext(B.sub, "smaller share")
  tx(ra - WA / 2, A.tp - 14, "share by read rate", "s mid halo tmp")
  tx(B.ix + 6 + WB / 2 + 30, A.tp - 14, "share by read rate", "s mid halo tmp")
  wait 900

  # Step 2: Each card holds its share of the heads and the feed-forward, or a range of a mixture's experts with the router whole on every card.
  step 2
  view (288, 56, 425, 400)
  remove query(".tmp")
  shape("rect", {class: "card-bg tmp", x: 280, y: 66, width: 440, height: 124, rx: 8})
  tx(294, 88, "1 LAYER, ZOOMED", "cap tmp")
  block(294, 100, 240, 32, "a tmp")
  block(538, 100, 168, 32, "b tmp")
  tx(414, 121, "card A: its heads, its rows", "on-blk mid tmp")
  tx(622, 121, "card B: the others", "on-blk mid tmp")
  tx(500, 156, "a mixture: a range of experts on each card,", "s mid tmp")
  tx(500, 174, "the router whole on every card", "s mid tmp")
  add "lit" to L[0].a, L[0].b
  wait 2200

  # Step 3: Each card computes its share of the attention heads, then the partial outputs are summed onto every card.
  step 3
  view (288, 360, 425, 280)
  remove query(".tmp")
  let sums = 0
  row 0 "0"
  # The cards sum their partial outputs of the layer `r` over the link.
  to sum(r, ms)
    let y = r.y + r.u / 2 - 1.5
    let p = shape("circle", {class: "sum", cx: ra, cy: y, r: 8})
    let q = shape("circle", {class: "sum", cx: B.ix + 6, cy: y, r: 8})
    add "on" to bus
    glideAll([[p, (B.ix + 6, y)], [q, (ra, y)]], ms)
    drop "on" from bus
    remove p, q
    sums += 1
    row 0 str(sums)
  end
  add "pulse-on" to L[0].a, L[0].b
  tx(500, A.tp - 14, "attention: each card its heads", "sb mid halo tmp")
  wait 1100
  drop "pulse-on" from L[0].a, L[0].b
  sum(L[0], 900)
  tx(B.ix + WB + 14, L[0].y + 6, "summed", "sb halo tmp")
  wait 600

  # Step 4: Each card computes its share of the feed-forward, then the outputs are summed again.
  step 4
  view (288, 360, 425, 280)
  remove query(".tmp")
  tx(500, A.tp - 14, "feed-forward: each card its rows", "sb mid halo tmp")
  add "pulse-on" to L[0].a, L[0].b
  wait 1000
  drop "pulse-on" from L[0].a, L[0].b
  sum(L[0], 900)
  tx(B.ix + WB + 14, L[0].y + 6, "summed again", "sb halo tmp")
  wait 800

  # Step 5: A layer that still cannot be split when it loads, wherever it sits in the stack, runs whole on the first card.
  step 5
  view (288, 300, 425, 300)
  remove query(".tmp")
  let r9 = L[9]
  add "gone" to r9.b
  launch([[r9.a, ra - LW, r9.y]], 0)
  setAttr(r9.a, "width", LW)
  shape("rect", {class: "ghost", x: B.ix + 6, y: r9.y, width: WB, height: U - 3, rx: 2})
  add "pulse-on" to r9.a
  tx(652, r9.y - 22, "cannot be", "sb mid halo")
  tx(652, r9.y - 5, "split: whole", "sb mid halo")
  tx(652, r9.y + 12, "on card A", "s mid halo")
  wait 2000
  drop "pulse-on" from r9.a

  # Step 6: The other layers run the same way, layer 9 whole on card A. After the last layer, the output head on the first card gives the logits.
  step 6
  view (288, 160, 425, 480)
  for r in L[1:]
    add "lit" to r.a, r.b
    if r.i == 9
      wait 220
    else
      sum(r, 140)
      sum(r, 140)
    end
  end
  let head = headAt(ra - LW, slotY(25, U), LW, U)
  add "pulse-on" to head.b
  let p = token(ra - LW / 2, slotY(23, U) + 5)
  glideAll([[p, (ra - LW / 2, slotY(25, U) + 8)]], 300)
  compute p for 700ms say "The output head on card A giving the logits"
  remove p
  logits(ra - LW / 2 - 30, A.tp - 18, "right")
  wait 1200
  drop "pulse-on" from head.b
end

# ---------------------------------------------------------------------------------------------
scene ladder
  # The placement ladder.
  add "gone" to query(".rail"), query(".rail-slot")
  let RX = 300
  let CX = 364
  let CW = 12.5
  let MX = CX + 24 * CW + 12
  let rungs = [
    {y: 106, name: "1. the plan the demand asks for", plan: [12, 8, 4], big: true},
    {y: 186, name: "2. an even split over 2 cards", plan: [13, 11, 0], big: true},
    {y: 266, name: "3. the cards at 70% with the host", plan: [12, 8, 4], big: false},
    {y: 322, name: "   at 50%", plan: [8, 6, 10], big: false},
    {y: 378, name: "   at 35%", plan: [6, 4, 14], big: false},
    {y: 434, name: "   at 20%", plan: [3, 2, 19], big: false},
    {y: 516, name: "4. the host", plan: [0, 0, 24], big: true}
  ]
  style(shape("rect", {class: "rl", x: RX - 6, y: 70, width: 11, height: 474, rx: 4}), "fill", F.wood)
  style(shape("rect", {class: "rl", x: RX + 36, y: 70, width: 11, height: 474, rx: 4}), "fill", F.wood)
  shape("path", {class: "brace", d: "M" + str(RX + 50) + ",252 h4 V444 h-4"})
  let R = []
  for g in rungs
    let cls = "rung" if g.big else "rung-s"
    let bar = shape("line", {class: cls, x1: RX, y1: g.y, x2: RX + 38, y2: g.y})
    let cells = []
    for j in range(24)
      let k = "a" if j < g.plan[0] else ("b" if j < g.plan[0] + g.plan[1] else "h")
      cells += [shape("rect", {class: "cell muted " + k, x: CX + j * CW, y: g.y - 3, width: CW - 1, height: 14, rx: 2})]
    end
    tx(CX, g.y - 9, g.name, "sb")
    R += [{y: g.y, bar: bar, cells: cells, cls: cls}]
  end
  let cur = shape("path", {class: "cursor mv", d: "M0,-9 L14,0 L0,9 Z"})
  put(cur, RX - 26, R[0].y + 4)
  # The cursor reaches the rung `k`, which lights its plan.
  to reach(k, ms)
    slide([[cur, RX - 26, R[k].y + 4]], ms)
    drop "muted" from R[k].cells
  end
  # The rung `k` fails on an out-of-memory error.
  to oom(k)
    sprite("bolt", (MX, R[k].y + 4))
    setAttr(R[k].bar, "class", R[k].cls + " bad")
    tx(CX, R[k].y + 28, "out of memory", "bad-t tmp")
    noise(140, 0.05)
  end
  # Step 0: The planned placement fails on the cards with an out-of-memory error.
  step 0
  view (262, 60, 430, 300)
  reach(0, 300)
  wait 700
  oom(0)
  wait 1000

  # Step 1: Rung 2, `an even split over 2 cards`, shares the layers out by each card's compute rate, or by its free memory when no rate is known.
  step 1
  view (262, 60, 430, 300)
  add "muted" to R[0].cells
  reach(1, 700)
  wait 900
  oom(1)
  wait 1000

  # Step 2: Rung 3, `the cards at 70% with the host`, would build what rung 1 already tried. A rung that repeats a tried placement is skipped.
  step 2
  view (262, 60, 430, 300)
  add "muted" to R[1].cells
  reach(2, 700)
  drop "muted" from R[0].cells
  wait 700
  add "greyed" to R[2].cells
  setAttr(R[2].bar, "class", "rung-s same")
  tx(CX, R[2].y + 26, "same plan as rung 1: skipped", "sb tmp")
  add "muted" to R[0].cells
  wait 1100

  # Step 3: Rung 3 goes on at 50%, then at 35% and 20%. It offers that share of each card's free memory and leaves the rest of the layers on the host.
  step 3
  view (262, 250, 430, 300)
  reach(3, 600)
  wait 900
  setAttr(R[3].bar, "class", "rung-s ok")
  sprite("check", (MX, R[3].y + 4))
  tx(CX, R[3].y + 28, "placed", "ok-t tmp")
  tx(CX, R[4].y + 28, "not tried", "s tmp")
  tx(CX, R[5].y + 28, "not tried", "s tmp")
  wait 1200

  # Step 4: Rung 4, `the host`, puts every layer off the cards. It is reached only when every rung above fails.
  step 4
  view (262, 330, 430, 250)
  drop "muted" from R[6].cells
  tx(CX, R[6].y + 28, "reached when every rung above fails", "s tmp")
  wait 1600
  add "muted" to R[6].cells

  # Step 5: A failure that is not out of memory goes straight to the host rung.
  # It is another run of the ladder: the marks of the first one go.
  step 5
  view (262, 60, 430, 520)
  remove query(".tmp"), query(".dkt-sprite")
  for [k, g] in enumerate(R)
    setAttr(g.bar, "class", g.cls)
    drop "greyed" from g.cells
    add "muted" to g.cells
  end
  slide([[cur, RX - 26, R[0].y + 4]], 500)
  drop "muted" from R[0].cells
  tx(CX, R[0].y + 28, "another error", "warn-t")
  wait 700
  shape("path", {class: "way-dot", d: "M" + str(RX - 14) + "," + str(R[0].y + 14) + " C" + str(RX - 34) + ",220 " + str(RX - 34) + ",420 " + str(RX - 14) + "," + str(R[6].y - 6)})
  add "muted" to R[0].cells
  slide([[cur, RX - 26, R[6].y + 4]], 1300)
  drop "muted" from R[6].cells
  setAttr(R[6].bar, "class", "rung ok")
  tx(CX, R[6].y + 28, "straight to the host", "ok-t")
  wait 1400
end

# ---------------------------------------------------------------------------------------------
scene recover
  # After the load: a request out of memory, and an idle model moved.
  let U = 13
  let RW = 100
  let A = column(266, 114, 22 * U, "a", "card A", "rank 1")
  let B = column(400, 114, 27 * U, "b", "card B", "rank 2")
  let H = column(534, 200, 22 * U, "h", "host", "host memory")
  link(380, 400, 520)
  link(514, 534, 520)
  let resA = resv(A.ix, A.tp, RW, U - 3)
  let resB = resv(B.ix, B.tp, RW, U - 3)
  let L = []
  for i in range(24)
    let c = A if i < 14 else B
    L += [layer(i, c.kind, RW, U, c.ix, slotY(i if i < 14 else i - 14, U))]
  end
  let head = headAt(B.ix, slotY(11, U), RW, U)
  let pools = [block(A.ix, slotY(n, U), RW, U - 3, "g") for n in range(14, 20)]
  let pt = word(A.mid, slotY(17, U) + 4, "pools", "sb mid")
  let idle1 = [block(B.ix, slotY(n, U), RW, U - 3, "g") for n in range(12, 16)]
  let it1 = word(B.mid, slotY(14, U), "idle model", "sb mid")
  let idle2 = [block(B.ix, slotY(n, U), RW, U - 3, "g") for n in range(16, 21)]
  let it2 = word(B.mid, slotY(18, U) + 4, "idle model", "sb mid")
  let xa = A.ix + (RW - KVW - 3) / 2
  # A request runs: its token climbs card A and runs out of memory there.
  to attempt()
    let p = token(xa, BASE + 2)
    climb(p, L[:6], xa, 50)
    let z = sprite("bolt", (A.x + A.w - 4, slotY(6, U)))
    noise(140, 0.05)
    remove p
    shade(L, "lit", false)
    wait 700
    remove z
  end
  # Step 0: At request time, an out-of-memory error first hands the pools back, and the request runs again.
  step 0
  view (258, 180, 270, 460)
  wait 600
  attempt()
  slide([[e, A.ix, 160] for e in pools] + [[pt, A.mid, 160]], 900)
  add "gone" to pools, pt
  tx(A.mid, 150, "pools handed back", "sb mid halo tmp")
  wait 400
  attempt()

  # Step 1: Still out of memory, the idle models are unloaded one at a time, the request running again after each.
  step 1
  view (258, 180, 270, 460)
  remove query(".tmp")
  add "gone" to idle1, it1
  tx(B.mid, B.tp - 14, "idle model unloaded", "sb mid halo tmp")
  wait 700
  attempt()
  add "gone" to idle2, it2
  tx(B.mid, B.tp - 32, "another one unloaded", "sb mid halo tmp")
  wait 700
  attempt()

  # Step 2: Then the model is placed again with the card that ran out keeping more back, its blocks going to a card with room. While the request still runs out, every card keeps more back, down to the host.
  step 2
  view (320, 180, 420, 460)
  remove query(".tmp")
  let more = resv(A.ix, A.tp + U, RW, 3 * U - 3, "gone")
  reveal([more], 0)
  tx(A.mid, A.tp - 14, "keeps more back", "sb mid halo tmp")
  let mv = []
  for r in L[10:]
    mv += spot(r, B.ix, slotY(r.i - 10, U))
  end
  mv += headTo(head, B.ix, slotY(15, U))
  slide(mv, 1200)
  for r in L[10:14]
    paint(r, "b")
  end
  retext(A.sub, "layers 0 to 9")
  retext(B.sub, "layers 10 to 23, head")
  attempt()
  remove query(".tmp")
  tx(500, 180, "every card keeps more back", "sb mid halo tmp")
  let moreA = resv(A.ix, A.tp + 4 * U, RW, 2 * U - 3, "gone")
  let moreB = resv(B.ix, B.tp + U, RW, 3 * U - 3, "gone")
  reveal([moreA, moreB], 100)
  let mv2 = []
  for r in L[8:10]
    mv2 += spot(r, B.ix, slotY(r.i - 8, U))
  end
  for r in L[10:20]
    mv2 += spot(r, B.ix, slotY(r.i - 8, U))
  end
  for r in L[20:]
    mv2 += spot(r, H.ix + 50, slotY(r.i - 20, U))
  end
  mv2 += headTo(head, B.ix, slotY(13, U))
  slide(mv2, 1300)
  for r in L[8:10]
    paint(r, "b")
  end
  for r in L[20:]
    paint(r, "h")
  end
  retext(A.sub, "layers 0 to 7")
  retext(B.sub, "layers 8 to 19, head")
  retext(H.sub, "layers 20 to 23")
  view (262, 150, 400, 480)
  let p = token(xa, BASE + 2)
  climb(p, L[:8], xa, 50)
  remove p
  sprite("check", (A.x + A.w - 4, slotY(8, U)))
  tx(A.mid, A.tp - 32, "answered", "ok-t mid halo tmp")
  wait 1200

  # Step 3: When a model is unloaded, an idle model moves whole to the fastest card it does not use that has room. A model already whole on 1 card moves only to a faster card.
  step 3
  view (262, 120, 430, 500)
  remove head.t
  let old = query(".blk") + query(".dkt-sprite") + query(".tmp")
  add "gone" to old
  retext(A.sub, "rank 1")
  retext(B.sub, "rank 2")
  retext(H.sub, "host memory")
  let fresh = [resv(A.ix, A.tp, RW, U - 3, "gone"), resv(B.ix, B.tp, RW, U - 3, "gone")]
  let M = []
  for i in range(24)
    let c = A if i < 18 else H
    M += [layer(i, c.kind + " gone", RW, U, c.ix if i < 18 else H.ix + 50, slotY(i if i < 18 else i - 18, U))]
  end
  let mh = headAt(A.ix, slotY(19, U), RW, U)
  add "gone" to mh.b, mh.t
  let other = [block(B.ix, slotY(n, U), RW, U - 3, "g gone") for n in range(0, 22)]
  let ot = word(B.mid, slotY(11, U), "a model in use", "sb mid halo gone")
  let order = []
  for r in M
    order += [r.w, r.k]
  end
  reveal(fresh + order + [mh.b, mh.t] + other + [ot], 8)
  remove old
  tx(500, 200, "idle model on card A and the host", "sb mid halo tmp")
  wait 900
  add "gone" to other, ot
  tx(B.mid, 192, "unloaded: room", "sb mid halo tmp")
  wait 900
  let mv3 = []
  for r in M
    mv3 += spot(r, B.ix, slotY(r.i, U))
  end
  mv3 += headTo(mh, B.ix, slotY(25, U))
  slide(mv3, 1500)
  for r in M
    paint(r, "b")
  end
  remove query(".tmp")
  tx(500, 132, "moved whole to card B,", "sb mid halo")
  tx(500, 150, "the fastest card it did not use", "s mid halo")
  wait 900
  let gy = BASE - 27 * U
  shape("rect", {class: "ghost", x: A.ix, y: gy, width: RW, height: 27 * U, rx: 3})
  shape("rect", {class: "over", x: A.ix - 3, y: gy, width: RW + 6, height: A.tp - gy, rx: 3})
  sprite("cross", (A.x + A.w + 10, A.tp + 2))
  tx(A.mid + 6, A.tp + 26, "too small", "bad-t mid halo")
  tx(268, gy - 28, "whole on 1 card: it moves", "s halo")
  tx(268, gy - 11, "only to a faster card with room", "s halo")
  wait 1600
end
