# Model directories: omit to use OS defaults
#   Linux:   ~/.ollama/models, ~/.cache/huggingface/hub
#   Windows: %USERPROFILE%\.ollama\models, %APPDATA%\huggingface\hub
# Uncomment to override:
# ollama_models_dir = '/path/to/ollama/models'
# huggingface_models_dir = '/path/to/huggingface/models'

[server]
host = "127.0.0.1"
port = 11435
# The address is the security boundary. Before the daemon listens on anything but localhost,
# turn authentication and a rate limit on:
# require_auth = true
# api_keys = ["change-me"]          # sent as `Authorization: Bearer <key>` or `X-API-Key`
# allowed_origins = []              # browser origins allowed once auth is on
# rate_limit_per_minute = 0         # per client, 0 = unlimited
# rate_limit_burst = 10

[inference]
# The model loaded when a request does not name one. Set it to a tag you actually have  - 
# `loken list` prints them. Nothing is downloaded to satisfy this.
model_id = "qwen3:0.6b"
# Sampling comes from the model (its Modelfile or generation_config.json) and the request;
# placement, threads, memory and the KV cache format from the machine. None is configured.

# Copies of a model served side by side, each whole on a card of its own, so concurrent
# requests run in parallel. A model that does not fit one card is served once.
# replicas = 1

# Seconds a conversation's kept state stays after its last turn, so the next turn reads only the
# tokens it adds. Past it the state is dropped. 0 keeps a state until the memory is needed.
# kv_lease_secs = 1800

# The disk tier keeps conversation snapshots across a restart, within a disk budget.
# kv_disk_dir = "/var/lib/loken/kv"
# kv_disk_budget_gb = 0             # 0 = no limit

# Another instance serving the same model reads this one's long prompts: it hands back their KV
# cache over the network and this one decodes. A prompt within a prefill chunk of what the cache
# already holds is read here, and so is any prompt when the peer cannot answer.
# prefill_peer = "http://192.0.2.10:11435"

# Each attention layer's cache cut into ranges of positions over every card, for a context no
# single card holds; the layers so cut run outside the recorded decode step.
# context_parallel = false

# DeepSeek V4.1 and models with recurrent layers keep the decode state of finished prompts and
# turns, so a prompt that begins with one seen before skips prefilling it. Without a directory the
# states stay in host memory for the life of the process; with one they go on disk and survive a
# restart. The files hold state derived from prompts (KV tensors, no text).
# state_cache_dir = "/var/lib/loken/state"
# state_cache_budget_gb = 0         # 0 = derived from the directory's free space

# Models whose routed experts stream from disk: `exact` keeps every output identical.
# quality = "exact"                 # exact, balanced (within the model's own noise) or fast

# Files, moderation and the URLs handed out.
# files_dir = "/var/lib/loken/files"   # uploads and batch outputs, default: files/ beside the model store
# moderation_model = "llama-guard3:1b" # Llama Guard, Shieldstral, ShieldGemma, Granite Guardian or gpt-oss Safeguard
# public_url = "https://loken.example.org" # the origin clients reach this server at, default: the request's Host

# [energy]
# enabled = true
# carbon_intensity = 50             # gCO2eq per kWh
# cpu_tdp_w = 0                     # host estimate when RAPL is unreadable, 0 = measured domains only
# water_l_per_kwh = 1.8

# [cpu]
# level = "avx512"                  # cap for the CPU kernels: generic (scalar reference), avx2 or avx512; default: the best the CPU has

# Clustering: see docs/CLUSTER.md. Absent, the node runs alone.
# [cluster]
# name = "home"
# advertise = "http://192.0.2.10:11435"
# join = []
